      "rule": "private-ip",
      "path": "(?:^test/|^packages/[^/]+/test/|[.]test[.]tsx?$)",
      "value": "(?:10[.]0[.]0[.]\\d{1,3}|192[.]168[.]1[.]\\d{1,3}|100[.]64[.]0[.]\\d{1,3})"
