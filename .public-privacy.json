{
  "deny": [
    {
      "id": "deployment-host",
      "pattern": "\\bsystem[-_](?:mnl|server)\\b|\\bdokp[l]oy\\b"
    },
    {
      "id": "private-company",
      "pattern": "brandso[l]idate|cool[- ]?j[a]ms|blueb[e]ards|sir[ -]waggingt[o]ns"
    },
    {
      "id": "private-person",
      "pattern": "\\ba[l]bert\\b|davidabusiewi[e]z@gmail[.]com"
    },
    {
      "id": "vault-prefix",
      "pattern": "systemtechd[e]v/|personal/forg[e]jo"
    },
    {
      "id": "private-ip",
      "pattern": "(?<![\\d.])(?:10(?:\\.\\d{1,3}){3}|192\\.168(?:\\.\\d{1,3}){2}|172\\.(?:1[6-9]|2\\d|3[01])(?:\\.\\d{1,3}){2}|100\\.(?:6[4-9]|[7-9]\\d|1[01]\\d|12[0-7])(?:\\.\\d{1,3}){2})(?![\\d.])|(?<![0-9a-f:])(?:f[cd][0-9a-f]{2}|fe[89ab][0-9a-f]):[0-9a-f:]+"
    },
    {
      "id": "scrub-deployment-variants",
      "pattern": "system(-|\\s|\\\\[nrt])+(server|mnl|usa)"
    },
    {
      "id": "scrub-person-boundary",
      "pattern": "(^|[^A-Za-z])seth([^A-Za-z]|$)"
    },
    {
      "id": "scrub-company-whitespace",
      "pattern": "brand(\\s|\\\\[nrt])*solidate"
    },
    {
      "id": "scrub-company-separator",
      "pattern": "cool(-|\\s|\\\\[nrt])+jams"
    },
    {
      "id": "scrub-company-name",
      "pattern": "bluebeards"
    },
    {
      "id": "scrub-company-phrase",
      "pattern": "sir(-|\\s|\\\\[nrt])+waggingtons"
    },
    {
      "id": "scrub-vault-organization",
      "pattern": "systemtechdev/"
    },
    {
      "id": "scrub-vault-service",
      "pattern": "personal/forgejo"
    },
    {
      "id": "scrub-vault-agents",
      "pattern": "personal/agents(/|$)"
    },
    {
      "id": "scrub-private-account",
      "pattern": "davidabusiewiez(@gmail[.]com)?"
    },
    {
      "id": "scrub-deployment-service",
      "pattern": "dokploy"
    },
    {
      "id": "scrub-relay-name",
      "pattern": "vm-relay-1"
    },
    {
      "id": "scrub-vault-host",
      "pattern": "bao[.]systemtech[.]dev"
    },
    {
      "id": "scrub-location-boundary",
      "pattern": "(^|[^A-Za-z])mnl([^A-Za-z]|$)"
    },
    {
      "id": "scrub-private-project",
      "pattern": "cortex"
    },
    {
      "id": "scrub-person-name",
      "pattern": "(^|[^A-Za-z])albert([^A-Za-z]|$)"
    },
    {
      "id": "scrub-private-address",
      "pattern": "100[.]109[.]204[.]54"
    },
    {
      "id": "scrub-private-release",
      "pattern": "v2026[.]9[.]24"
    },
    {
      "id": "scrub-organization-boundary",
      "pattern": "(^|[^A-Za-z0-9_.-])systemtech([^A-Za-z0-9_.]|$)"
    },
    {
      "id": "scrub-private-remote-alias",
      "pattern": "git-systemtech"
    },
    {
      "id": "scrub-audit-marker",
      "pattern": "oa9YJpNDk68"
    },
    {
      "id": "scrub-private-revision",
      "pattern": "d3b25b5"
    },
    {
      "id": "scrub-runner-name",
      "pattern": "(vm|desk|mba)-(ci|macos)-[0-9]+"
    }
  ],
  "allow": [
    {
      "rule": "private-ip",
      "path": "(?:^test/|^packages/[^/]+/test/|[.]test[.]tsx?$)",
      "value": "(?:10[.]0[.]0[.]\\d{1,3}|192[.]168[.]1[.]\\d{1,3}|100[.]64[.]0[.]\\d{1,3})"
    }
  ]
}
