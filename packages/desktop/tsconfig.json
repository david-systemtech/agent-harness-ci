{
  // The desktop's main process and its preload: Node's types and Electron's, which the `electron` package carries.
  // The preload runs in the window's sandbox and is bundled into one CommonJS file by Vite (vite.config.ts); tsc
  // only checks it there.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "references": [{ "path": "../contracts" }, { "path": "../filesystem" }, { "path": "../client-runtime" }, { "path": "../theme" }]
}
