{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StateImportClientLocal",
  "type": "object",
  "properties": {
    "mode": {
      "description": "The light, dark or system mode.",
      "type": "string",
      "enum": [
        "light",
        "dark",
        "system"
      ]
    },
    "fontSize": {
      "description": "The conversation's font size, in pixels.",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "conversationWidth": {
      "description": "The conversation's width.",
      "type": "string",
      "enum": [
        "comfortable",
        "wide",
        "full"
      ]
    },
    "showThinking": {
      "description": "Whether a run's thinking shows.",
      "type": "boolean"
    },
    "settingsRow": {
      "description": "The row of Settings last open, mapped through the address table.",
      "type": "string",
      "enum": [
        "setup.checklist",
        "accounts.accounts",
        "accounts.default-model",
        "accounts.usage",
        "knowledge.banks",
        "knowledge.skills",
        "knowledge.instructions",
        "access.permissions",
        "access.browser",
        "access.key-managers",
        "access.forges",
        "routines.routines",
        "routines.bots",
        "environments.machines",
        "environments.access",
        "environments.service",
        "appearance.theme",
        "appearance.shortcuts",
        "about.about"
      ]
    }
  },
  "description": "The client-local values a state import carries: applied by the client that ran it only on the environment's machine."
}
