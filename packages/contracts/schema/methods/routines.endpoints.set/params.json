{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "routines.endpoints.set params",
  "type": "object",
  "properties": {
    "commandId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "The client-generated UUID every command takes; a retry with the same id applies once."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,40}$",
      "description": "A webhook endpoint's name on its environment: 1 to 40 lower-case letters, digits and hyphens, unique."
    },
    "url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https?:\\/\\/",
      "description": "Where the endpoint's POSTs go: https, or http only to loopback, localhost, a private or tailnet address or a .ts.net name; with no userinfo, and its host off the denylist."
    },
    "secret": {
      "description": "The endpoint's secret; the one held is kept when absent.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pasted"
            },
            "secret": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[\\x21-\\x7e]+$",
              "description": "The secret, 1 to 4096 printable ASCII characters with no space; a whsec_ secret is keyed by its decoded bytes. Kept in the vault and never answered back."
            }
          },
          "required": [
            "kind",
            "secret"
          ],
          "description": "A secret sent once and kept in the environment's vault."
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "reference"
            },
            "reference": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "const": "openbao"
                    },
                    "connectionId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                      "description": "The key-manager connection the reference is read through."
                    },
                    "mount": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024,
                      "pattern": "^[^/\\p{Cc}]+(?:\\/[^/\\p{Cc}]+)*$",
                      "description": "The KV mount, as personal or secret/team: no slash at either end."
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024,
                      "pattern": "^[^/\\p{Cc}]+(?:\\/[^/\\p{Cc}]+)*$",
                      "description": "The secret's path under the mount, as harness/forge-github."
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\p{Cc}]+$",
                      "description": "The key inside the secret whose value is read."
                    }
                  },
                  "required": [
                    "provider",
                    "connectionId",
                    "mount",
                    "path",
                    "key"
                  ],
                  "description": "A value in OpenBao or Vault: a key of the secret at a path under a KV mount."
                },
                {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "const": "doppler"
                    },
                    "connectionId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                      "description": "The key-manager connection the reference is read through."
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 256,
                      "pattern": "^[A-Z_][A-Z0-9_]*$",
                      "description": "The secret's name: upper-case letters, digits and underscores, not starting with a digit."
                    },
                    "project": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\p{Cc}]+$",
                      "description": "The project, when the connection's token does not fix one."
                    },
                    "config": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\p{Cc}]+$",
                      "description": "The config, when the connection's token does not fix one."
                    }
                  },
                  "required": [
                    "provider",
                    "connectionId",
                    "name"
                  ],
                  "description": "A Doppler secret by name, with its project and config when the token does not fix them."
                },
                {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "const": "onepassword"
                    },
                    "connectionId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                      "description": "The key-manager connection the reference is read through."
                    },
                    "vault": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\p{Cc}]+$",
                      "description": "The vault, by name or id."
                    },
                    "item": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\p{Cc}]+$",
                      "description": "The item, by name or id."
                    },
                    "field": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\p{Cc}]+$",
                      "description": "The field whose value is read."
                    }
                  },
                  "required": [
                    "provider",
                    "connectionId",
                    "vault",
                    "item",
                    "field"
                  ],
                  "description": "A 1Password field, as an op:// reference names it: vault, item and field."
                },
                {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "const": "bitwarden"
                    },
                    "connectionId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                      "description": "The key-manager connection the reference is read through."
                    },
                    "secretId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                      "description": "The secret's id, which is what is read."
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\p{Cc}]+$",
                      "description": "The secret's key, for display only."
                    }
                  },
                  "required": [
                    "provider",
                    "connectionId",
                    "secretId",
                    "key"
                  ],
                  "description": "A Bitwarden Secrets Manager secret by id, with its key for display."
                }
              ],
              "description": "Where a credential sits in a key manager, never its value: the provider, the connection it is read through, and the provider's locator (OpenBao mount, path and key; a Doppler name with its project and config; a 1Password vault, item and field; a Bitwarden secret id with its key)."
            }
          },
          "required": [
            "kind",
            "reference"
          ],
          "description": "A key-manager reference resolved per delivery."
        }
      ]
    }
  },
  "required": [
    "commandId",
    "name",
    "url"
  ]
}
