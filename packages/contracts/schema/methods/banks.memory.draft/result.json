{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "banks.memory.draft result",
  "type": "object",
  "properties": {
    "bank": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "A bank's name: 1 to 40 characters of lower-case letters, digits and single hyphens between them, unique per environment."
    },
    "change": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "draft"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "removePaths": {
              "description": "Prior paths of this name removed when the draft moves to a different scope or topic.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name",
            "path",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "retire"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "removePaths": {
              "description": "Prior paths removed by queued moves of this name.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "name",
            "path",
            "reason"
          ]
        }
      ]
    }
  },
  "required": [
    "bank",
    "change"
  ]
}
