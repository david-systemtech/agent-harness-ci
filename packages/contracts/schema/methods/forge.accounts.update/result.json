                    "unknown"
                  ],
                  "description": "Whether a forge account can do something: verified (a probe or an operation succeeded), failed (refused) or unknown (not tried yet)."
                },
                "verifiedAt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                      "description": "An instant as an ISO 8601 UTC timestamp."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "When it was last found verified; null until it has been."
                },
                "status": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The HTTP status a failure answered; null unless it failed."
                }
              },
              "required": [
                "state",
                "verifiedAt",
                "status"
              ],
              "description": "What is known of one capability: its state, when it was last verified, and a failure's status."
            },
