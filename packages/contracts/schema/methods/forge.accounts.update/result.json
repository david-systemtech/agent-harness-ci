        "primary": {
          "type": "boolean",
          "description": "Whether this is the primary forge: at most one forge account on an environment is."
        },
        "problem": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "needs-credential",
                    "credential-rejected",
                    "credential-unavailable",
                    "identity-changed",
                    "unreachable",
                    "expiring"
                  ],
                  "description": "What is wrong with a forge account: needs-credential (a copy with none), credential-rejected (401 on its identity), credential-unavailable (the key manager or gh signed out, or the vault entry missing), identity-changed (another user id answered; unused until the credential is replaced), unreachable (the forge did not answer) or expiring (the token expires within thirty days)."
                },
                "since": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                  "description": "Since when the forge account has had this problem."
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\n]*$",
                  "description": "One plain line for people: what is wrong and what to do. It holds no HTTP status, user id or exact time: those are in details."
                },
                "details": {
                  "description": "The raw facts behind the line; absent when there are none, and on a problem recorded before details were.",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^\\r\\n]*$"
                  }
                }
              },
              "required": [
                "kind",
                "since",
                "message"
              ],
              "description": "A forge account's problem: which, since when, one plain line saying what to do, and the raw facts behind it."
            },
            {
              "type": "null"
            }
          ],
          "description": "What is wrong, or null."
        },
        "statusSince": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "description": "When the forge account's status last changed: the problem's since-time while it has one, else when it was last found without one (added, or cleared of a problem). A verification that finds nothing new never moves it, so the orientation block can say how long a status has held."
        },
        "tokenInformation": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "classic",
                    "fine-grained",
                    "oauth",
                    "unknown"
                  ],
                  "description": "What kind of token a credential is: classic, fine-grained, oauth, or unknown (a Forgejo or Gitea token, which does not say)."
                },
                "scopes": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The scopes the forge's scope header named, a hint only; null when it sent none."
                },
                "expiresAt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                      "description": "An instant as an ISO 8601 UTC timestamp."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "When the token expires, when the forge says; null otherwise."
                }
              },
              "required": [
                "kind",
                "scopes",
                "expiresAt"
              ],
              "description": "What a verification read of a forge account's token: its kind, the scope header as a hint, and its expiry."
            },
            {
              "type": "null"
            }
          ],
          "description": "What a verification read of the token; null until one has."
        },
        "variables": {
          "type": "object",
          "properties": {
            "url": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "The variables holding the canonical origin: FORGE_<SLUG>_URL, and FORGE_URL for the primary."
            },
            "token": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "The variables holding the token: FORGE_<SLUG>_TOKEN, FORGE_TOKEN for the primary, GH_TOKEN for github.com."
            },
            "kind": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "The variables holding the kind: FORGE_<SLUG>_KIND, and FORGE_KIND for the primary."
            }
          },
          "required": [
            "url",
            "token",
            "kind"
          ],
          "description": "The exact names of the variables a forge account injects into a run; all empty for one that injects nothing (identity-changed or needs-credential)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "description": "When the forge account was added."
        },
        "copiedFrom": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "environmentId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "description": "An environment's persistent id: a UUID made on its first start, kept across address changes."
                },
                "environmentName": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The source environment's name when the copy was made."
                }
              },
              "required": [
                "environmentId",
                "environmentName"
              ],
              "description": "The environment a forge account was copied from."
            },
            {
              "type": "null"
            }
          ],
          "description": "The environment it was copied from; null for one added here."
        }
      },
      "required": [
        "id",
        "origin",
        "aliases",
        "kind",
        "slug",
        "identity",
        "credential",
        "capabilities",
        "primary",
        "problem",
        "statusSince",
        "tokenInformation",
        "variables",
        "createdAt",
        "copiedFrom"
      ],
      "description": "A forge account the environment holds: its origin and aliases, kind, slug, identity, credential source, capabilities, primary flag, problem and since when its status holds, token information, the variables it injects, when it was added and where it was copied from. Never a secret."
    }
  },
  "required": [
    "account"
  ]
}
