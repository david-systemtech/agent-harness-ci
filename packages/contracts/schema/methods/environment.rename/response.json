{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "environment.rename response",
  "type": "object",
  "properties": {
    "receipt": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "accepted"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "The log's head once the command committed: its last event, or the head it saw when it appended none."
            },
            "changed": {
              "type": "boolean",
              "description": "False for a command that was accepted and changed nothing, so appended no event."
            }
          },
          "required": [
            "status",
            "sequence",
            "changed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "rejected"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "The log's head when the command was rejected."
            },
            "changed": {
              "type": "boolean",
              "const": false
            },
            "reason": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "description": "Why the command was rejected, the code of its error: not_found when its target does not exist."
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "description": "A stable error code in snake case."
                },
                "message": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "code",
                "message",
                "data"
              ],
              "description": "The rejection as an error: its code (the reason), a message for people and structured data."
            }
          },
          "required": [
            "status",
            "sequence",
            "changed",
            "reason",
            "error"
          ]
        }
      ],
      "description": "A command's receipt: accepted (with the head sequence after it and whether it changed anything) or rejected (with the reason and the error). A retry with the same commandId answers the same receipt."
    },
    "result": {
      "description": "The method's result, present when this request applied the command; absent on a retry and on a rejection.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The environment's name."
        },
        "icon": {
          "type": "string",
          "enum": [
            "laptop",
            "desktop",
            "server",
            "nas",
            "cloud",
            "container",
            "board",
            "home",
            "office",
            "lab"
          ],
          "description": "An environment's icon, by name, one of the ten the enum lists (ADR 0025's fixed set): each client draws the name its own way, and the terminal UI draws none."
        },
        "colour": {
          "type": "string",
          "enum": [
            "red",
            "orange",
            "amber",
            "yellow",
            "lime",
            "green",
            "teal",
            "cyan",
            "blue",
            "indigo",
            "violet",
            "pink"
          ],
          "description": "An environment's colour, by name: red, orange, amber, yellow, lime, green, teal, cyan, blue, indigo, violet or pink. Never a literal: each client draws it with the theme's token for the name."
        }
      },
      "required": [
        "name",
        "icon",
        "colour"
      ]
    }
  },
  "required": [
    "receipt"
  ]
}
