{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "groups.rename response",
  "type": "object",
  "properties": {
    "receipt": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "accepted"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "The log's head once the command committed: its last event, or the head it saw when it appended none."
            },
            "changed": {
              "type": "boolean",
              "description": "False for a command that was accepted and changed nothing, so appended no event."
            }
          },
          "required": [
            "status",
            "sequence",
            "changed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "rejected"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "The log's head when the command was rejected."
            },
            "changed": {
              "type": "boolean",
              "const": false
            },
            "reason": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "description": "Why the command was rejected, the code of its error: not_found when its target does not exist."
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "description": "A stable error code in snake case."
                },
                "message": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "code",
                "message",
                "data"
              ],
              "description": "The rejection as an error: its code (the reason), a message for people and structured data."
            }
          },
          "required": [
            "status",
            "sequence",
            "changed",
            "reason",
            "error"
          ]
        }
      ],
      "description": "A command's receipt: accepted (with the head sequence after it and whether it changed anything) or rejected (with the reason and the error). A retry with the same commandId answers the same receipt."
    },
    "result": {
      "description": "The method's result, present when this request applied the command; absent on a retry and on a rejection.",
      "type": "object",
      "properties": {
        "group": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "A group's id: a UUID the creating client mints, kept in lowercase."
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "\\S",
              "description": "A group's name: 1 to 80 characters, not all white space; stored trimmed with white space collapsed, unique per environment ignoring case."
            },
            "orderKey": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z]*[b-z]$",
                  "description": "A fractional order key: letters a to z compared as plain strings, never empty and never ending in a, so a key can always be made before any other."
                },
                {
                  "type": "null"
                }
              ]
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "description": "An instant as an ISO 8601 UTC timestamp."
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "description": "An instant as an ISO 8601 UTC timestamp."
            }
          },
          "required": [
            "id",
            "name",
            "orderKey",
            "createdAt",
            "updatedAt"
          ],
          "description": "A named container of sessions on one environment; a session names its group."
        }
      },
      "required": [
        "group"
      ]
    }
  },
  "required": [
    "receipt"
  ]
}
