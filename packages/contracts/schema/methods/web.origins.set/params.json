{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "web.origins.set params",
  "type": "object",
  "properties": {
    "commandId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "The client-generated UUID every command takes; a retry with the same id applies once."
    },
    "clientOrigins": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https:\\/\\/(?:\\[[0-9a-f:]+\\]|[a-z0-9.-]+)(?::(?!443$)[1-9][0-9]{0,4})?$"
      },
      "uniqueItems": true
    },
    "connectOrigins": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https:\\/\\/(?:\\[[0-9a-f:]+\\]|[a-z0-9.-]+)(?::(?!443$)[1-9][0-9]{0,4})?$"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "commandId",
    "clientOrigins",
    "connectOrigins"
  ]
}
