{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "permissions.review.seen params",
  "type": "object",
  "properties": {
    "commandId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "The client-generated UUID every command takes; a retry with the same id applies once."
    },
    "through": {
      "description": "The position to mark seen through: a list's head. The log's head when absent.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "commandId"
  ]
}
