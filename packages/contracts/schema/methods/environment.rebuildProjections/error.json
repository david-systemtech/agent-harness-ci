            }
          },
          "required": [
            "scope"
          ]
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "description": "The client session lacks the scope the method requires, named in data.scope."
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "unavailable"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "readiness": {
              "type": "string",
              "enum": [
                "starting",
                "draining"
              ]
