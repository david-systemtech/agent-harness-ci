    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "internal"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {}
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "description": "The environment failed; nothing the client sent is at fault."
