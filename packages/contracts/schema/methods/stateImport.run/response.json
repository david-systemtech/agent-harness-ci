{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stateImport.run response",
  "type": "object",
  "properties": {
    "receipt": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "accepted"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "The log's head once the command committed: its last event, or the head it saw when it appended none."
            },
            "changed": {
              "type": "boolean",
              "description": "False for a command that was accepted and changed nothing, so appended no event."
            }
          },
          "required": [
            "status",
            "sequence",
            "changed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "rejected"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "The log's head when the command was rejected."
            },
            "changed": {
              "type": "boolean",
              "const": false
            },
            "reason": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "description": "Why the command was rejected, the code of its error: not_found when its target does not exist."
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "description": "A stable error code in snake case."
                },
                "message": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "code",
                "message",
                "data"
              ],
              "description": "The rejection as an error: its code (the reason), a message for people and structured data."
            }
          },
          "required": [
            "status",
            "sequence",
            "changed",
            "reason",
            "error"
          ]
        }
      ],
      "description": "A command's receipt: accepted (with the head sequence after it and whether it changed anything) or rejected (with the reason and the error). A retry with the same commandId answers the same receipt."
    },
    "result": {
      "description": "The method's result, present when this request applied the command; absent on a retry and on a rejection.",
      "type": "object",
      "properties": {
        "carried": {
          "type": "object",
          "properties": {
            "accounts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Config directories adopted in place as accounts."
            },
            "archived": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Sessions archived by a leftover archive key."
            },
            "pins": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Sessions pinned."
            },
            "groups": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Groups carried by name, merged into same-named ones."
            },
            "forgeAccounts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Forge accounts made from per-bank forge credentials."
            },
            "keyManagerConnections": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Key-manager connections carried as records awaiting sign-in."
            },
            "banks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Memory banks pointing at their existing checkouts."
            },
            "routines": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Routines, each imported disabled."
            },
            "instructions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Owned instructions made from custom or taken-over prompts."
            },
            "skillSources": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Skill sources made from tracked repositories."
            },
            "alwaysOnSkills": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Always-on skill names applied per mapped account."
            },
            "drafts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Drafts carried into empty session drafts."
            },
            "devSites": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Dev sites carried into the page policy."
            }
          },
          "required": [
            "accounts",
            "archived",
            "pins",
            "groups",
            "forgeAccounts",
            "keyManagerConnections",
            "banks",
            "routines",
            "instructions",
            "skillSources",
            "alwaysOnSkills",
            "drafts",
            "devSites"
          ],
          "description": "What a state import carried, counted per kind."
        },
        "sharedProjects": {
          "description": "Source profiles sharing a real projects folder with another: their sessions and memory carry once, with the owner, and not again with them.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1,
                "description": "The source profile whose projects folder is the owner's."
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "description": "That profile's label: what the report names it by."
              },
              "ownerSourceId": {
                "type": "string",
                "minLength": 1,
                "description": "The source profile its sessions and memory carry with."
              },
              "ownerLabel": {
                "type": "string",
                "minLength": 1,
                "description": "The owner's label."
              }
            },
            "required": [
              "sourceId",
              "label",
              "ownerSourceId",
              "ownerLabel"
            ]
          }
        },
        "reEnter": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "description": "What it is, for a person."
              },
              "step": {
                "type": "string",
                "enum": [
                  "account",
                  "carry-over",
                  "your-machines",
                  "forges",
                  "key-manager",
                  "memory-bank",
                  "skills",
                  "instructions",
                  "browser",
                  "permissions",
                  "appearance"
                ],
                "description": "The step whose card takes it: Account, Forges, Key manager or Memory bank."
              }
            },
            "required": [
              "label",
              "step"
            ],
            "description": "Something a state import needs the person to enter again: what, and the step that takes it."
          },
          "description": "What must be entered again, each with the step that takes it."
        },
        "later": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "description": "What it is, for a person."
              },
              "provider": {
                "type": "string",
                "minLength": 1,
                "description": "The provider its adapter serves."
              }
            },
            "required": [
              "label",
              "provider"
            ],
            "description": "A profile of a provider whose adapter arrives in milestone 2: a re-run then carries it with its sessions."
          },
          "description": "What arrives in milestone 2: other providers' profiles."
        },
        "notCarried": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "description": "What it is, for a person."
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "How many the source held."
              },
              "step": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "account",
                      "carry-over",
                      "your-machines",
                      "forges",
                      "key-manager",
                      "memory-bank",
                      "skills",
                      "instructions",
                      "browser",
                      "permissions",
                      "appearance"
                    ],
                    "description": "A step of the milestone-1 checklist, registered or not, each with the label every client names it by: account (Account), carry-over (Carry over), your-machines (Your machines), forges (Forges), key-manager (Key manager), memory-bank (Memory bank), skills (Skills), instructions (Instructions), browser (Browser), permissions (Permissions), appearance (Appearance)."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The step to set it up again on (Your machines for saved connections, Browser for pairings); null when none does."
              }
            },
            "required": [
              "label",
              "count",
              "step"
            ],
            "description": "Something a state import never carries: what, how many, and the step to set it up on again, if any."
          },
          "description": "What never carries."
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "description": "What it is, for a person."
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "description": "What went wrong, for a person."
              }
            },
            "required": [
              "label",
              "message"
            ],
            "description": "What a state import could not carry: the item, and why."
          },
          "description": "What could not be carried, each with why; empty when everything was."
        },
        "clientLocal": {
          "type": "object",
          "properties": {
            "mode": {
              "description": "The light, dark or system mode.",
              "type": "string",
              "enum": [
                "light",
                "dark",
                "system"
              ]
            },
            "fontSize": {
              "description": "The conversation's font size, in pixels.",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "conversationWidth": {
              "description": "The conversation's width.",
              "type": "string",
              "enum": [
                "comfortable",
                "wide",
                "full"
              ]
            },
            "showThinking": {
              "description": "Whether a run's thinking shows.",
              "type": "boolean"
            },
            "settingsRow": {
              "description": "The row of Settings last open, mapped through the address table.",
              "type": "string",
              "enum": [
                "setup.checklist",
                "accounts.accounts",
                "accounts.default-model",
                "accounts.usage",
                "knowledge.banks",
                "knowledge.skills",
                "knowledge.instructions",
                "access.permissions",
                "access.browser",
                "access.key-managers",
                "access.forges",
                "routines.routines",
                "routines.bots",
                "environments.machines",
                "environments.access",
                "environments.service",
                "appearance.theme",
                "appearance.shortcuts",
                "about.about"
              ]
            }
          },
          "description": "The client-local values a state import carries: applied by the client that ran it only on the environment's machine."
        },
        "dryRun": {
          "type": "boolean",
          "description": "Whether it was a dry run: the report of what an import would do, with nothing written."
        }
      },
      "required": [
        "carried",
        "reEnter",
        "later",
        "notCarried",
        "failed",
        "clientLocal",
        "dryRun"
      ]
    }
  },
  "required": [
    "receipt"
  ]
}
