{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "browser.chromes.rename params",
  "type": "object",
  "properties": {
    "commandId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "The client-generated UUID every command takes; a retry with the same id applies once."
    },
    "chromeId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "A paired Chrome's id: a UUID its environment mints when it pairs."
    },
    "name": {
      "type": "string",
      "maxLength": 1000,
      "description": "The new name, as typed: trimmed, cleaned and cut to 80 characters, A browser when nothing is left."
    }
  },
  "required": [
    "commandId",
    "chromeId",
    "name"
  ]
}
