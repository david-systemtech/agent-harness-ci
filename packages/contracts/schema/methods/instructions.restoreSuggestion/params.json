{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "instructions.restoreSuggestion params",
  "type": "object",
  "properties": {
    "commandId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "The client-generated UUID every command takes; a retry with the same id applies once."
    },
    "catalogueId": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^(?:setup|coding|working|custom)\\.[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "The catalogue entry."
    }
  },
  "required": [
    "commandId",
    "catalogueId"
  ]
}
