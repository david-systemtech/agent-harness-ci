{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "banks.credential.set params",
  "type": "object",
  "properties": {
    "commandId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "The client-generated UUID every command takes; a retry with the same id applies once."
    },
    "bankId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "description": "A bank's id: a version 4 UUID the registering client mints, kept in lowercase."
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n\\0]+$",
      "description": "A token sent directly once, kept in the environment vault and never returned."
    }
  },
  "required": [
    "commandId",
    "bankId",
    "token"
  ]
}
