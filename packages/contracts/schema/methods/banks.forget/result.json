{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "banks.forget result",
  "type": "object",
  "properties": {
    "bankId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "description": "A bank's id: a version 4 UUID the registering client mints, kept in lowercase."
    },
    "checkoutRemoved": {
      "type": "boolean"
    }
  },
  "required": [
    "bankId",
    "checkoutRemoved"
  ]
}
