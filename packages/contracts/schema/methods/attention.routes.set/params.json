{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "attention.routes.set params",
  "type": "object",
  "properties": {
    "commandId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "The client-generated UUID every command takes; a retry with the same id applies once."
    },
    "target": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "label": {
          "description": "A name for people, shown in place of the id; a push registration names its browser and when it was enabled.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "transport": {
          "type": "string",
          "enum": [
            "webhook",
            "push"
          ],
          "description": "Closed-client delivery transport: signed webhook or Web Push."
        },
        "enabled": {
          "type": "boolean"
        },
        "completion": {
          "type": "boolean"
        },
        "configuration": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 100
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          },
          "maxProperties": 16
        }
      },
      "required": [
        "id",
        "transport",
        "enabled",
        "completion",
        "configuration"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "commandId",
    "target"
  ]
}
