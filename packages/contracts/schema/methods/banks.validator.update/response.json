{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "banks.validator.update response",
  "type": "object",
  "properties": {
    "receipt": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "accepted"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "The log's head once the command committed: its last event, or the head it saw when it appended none."
            },
            "changed": {
              "type": "boolean",
              "description": "False for a command that was accepted and changed nothing, so appended no event."
            }
          },
          "required": [
            "status",
            "sequence",
            "changed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "rejected"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "The log's head when the command was rejected."
            },
            "changed": {
              "type": "boolean",
              "const": false
            },
            "reason": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "description": "Why the command was rejected, the code of its error: not_found when its target does not exist."
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "description": "A stable error code in snake case."
                },
                "message": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "code",
                "message",
                "data"
              ],
              "description": "The rejection as an error: its code (the reason), a message for people and structured data."
            }
          },
          "required": [
            "status",
            "sequence",
            "changed",
            "reason",
            "error"
          ]
        }
      ],
      "description": "A command's receipt: accepted (with the head sequence after it and whether it changed anything) or rejected (with the reason and the error). A retry with the same commandId answers the same receipt."
    },
    "result": {
      "description": "The method's result, present when this request applied the command; absent on a retry and on a rejection.",
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "The environment's BANK_VALIDATOR version."
        },
        "landing": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string",
                      "const": "landed"
                    },
                    "bank": {
                      "type": "string",
                      "maxLength": 40,
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                      "description": "A bank's name: 1 to 40 characters of lower-case letters, digits and single hyphens between them, unique per environment."
                    },
                    "pullRequest": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "state": {
                            "type": "string",
                            "enum": [
                              "present",
                              "removed"
                            ],
                            "description": "Verified main state: the written file is present with its exact content, or the retired file is removed."
                          }
                        },
                        "required": [
                          "path",
                          "state"
                        ]
                      }
                    }
                  },
                  "required": [
                    "state",
                    "bank",
                    "pullRequest",
                    "files"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string",
                      "const": "awaiting-review"
                    },
                    "bank": {
                      "type": "string",
                      "maxLength": 40,
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                      "description": "A bank's name: 1 to 40 characters of lower-case letters, digits and single hyphens between them, unique per environment."
                    },
                    "pullRequest": {
                      "type": "string"
                    },
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "state": {
                            "type": "string",
                            "const": "pending"
                          }
                        },
                        "required": [
                          "path",
                          "state"
                        ]
                      }
                    }
                  },
                  "required": [
                    "state",
                    "bank",
                    "pullRequest",
                    "files"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string",
                      "const": "failed"
                    },
                    "bank": {
                      "type": "string",
                      "maxLength": 40,
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                      "description": "A bank's name: 1 to 40 characters of lower-case letters, digits and single hyphens between them, unique per environment."
                    },
                    "step": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "state",
                    "bank",
                    "step",
                    "reason"
                  ]
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "The reviewed update's state, or null when the bank already has equal or newer rules."
        }
      },
      "required": [
        "version",
        "landing"
      ]
    }
  },
  "required": [
    "receipt"
  ]
}
