{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "commands.list params",
  "type": "object",
  "properties": {
    "accountId": {
      "description": "The account; the environment's default account when absent.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "workspace": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "directory"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "The directory on the environment's machine."
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "description": "A directory the environment has."
        }
      ],
      "description": "Where a session's code lives on its environment: its kind and path."
    }
  },
  "required": [
    "workspace"
  ]
}
