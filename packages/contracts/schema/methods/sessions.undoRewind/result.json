{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sessions.undoRewind result",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "description": "A session's id: a version 4 UUID the creating client mints (never the provider's resume id), kept in lowercase."
    },
    "messageId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "description": "The user message the undone rewind went back to."
    },
    "rewindSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "The sequence of the session.rewound undone."
    }
  },
  "required": [
    "sessionId",
    "messageId",
    "rewindSequence"
  ]
}
