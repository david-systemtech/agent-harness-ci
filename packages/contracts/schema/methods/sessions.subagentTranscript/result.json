{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sessions.subagentTranscript result",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "description": "A session's id: a version 4 UUID the creating client mints (never the provider's resume id), kept in lowercase."
    },
    "agentId": {
      "type": "string",
      "minLength": 1
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      },
      "description": "The subagent's messages as the provider stores them, oldest first; their shape is the provider's."
    }
  },
  "required": [
    "sessionId",
    "agentId",
    "messages"
  ]
}
