{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "banks.pin params",
  "type": "object",
  "properties": {
    "commandId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "The client-generated UUID every command takes; a retry with the same id applies once."
    },
    "sessionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "description": "A session's id: a version 4 UUID the creating client mints (never the provider's resume id), kept in lowercase."
    },
    "pointer": {
      "type": "string",
      "pattern": "^(?=[^:]{1,40}:)[a-z0-9]+(?:-[a-z0-9]+)*:(?:(?:(?!(?:memories|\\.{1,2})\\/)[^/\\s:]+\\/){1,3}|(?:(?!(?:memories|\\.{1,2})\\/)[^/\\s:]+\\/){2,3}memories\\/[a-z0-9]+(?:-[a-z0-9]+)*\\/)$",
      "description": "A folder pointer bank:org/[project/[area/]], or a topic pointer bank:org/project/[area/]memories/topic/: a pin expands it whole."
    },
    "pinned": {
      "type": "boolean"
    }
  },
  "required": [
    "commandId",
    "sessionId",
    "pointer",
    "pinned"
  ]
}
