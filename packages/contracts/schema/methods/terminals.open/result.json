{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "terminals.open result",
  "type": "object",
  "properties": {
    "terminal": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
              "description": "A terminal's id: a version 4 UUID the opening client mints, unique on the environment and never reused, kept in lowercase."
            },
            "owner": {
              "type": "string",
              "const": "session",
              "description": "A session's terminal: listed and counted under it, closed with it."
            },
            "sessionId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
              "description": "A session's id: a version 4 UUID the creating client mints (never the provider's resume id), kept in lowercase."
            },
            "openedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "description": "An instant as an ISO 8601 UTC timestamp."
            },
            "cols": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "description": "A terminal's width in columns, 1 to 1,000."
            },
            "rows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "description": "A terminal's height in rows, 1 to 1,000."
            },
            "exitCode": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ],
              "description": "The shell's exit code once it has exited; null while it runs."
            },
            "signal": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ],
              "description": "The signal that ended the shell, when one did; null otherwise or while it runs."
            }
          },
          "required": [
            "id",
            "owner",
            "sessionId",
            "openedAt",
            "cols",
            "rows",
            "exitCode",
            "signal"
          ],
          "description": "A session's terminal: the user's login shell in the session's workspace."
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
              "description": "A terminal's id: a version 4 UUID the opening client mints, unique on the environment and never reused, kept in lowercase."
            },
            "owner": {
              "type": "string",
              "const": "managed-tools",
              "description": "A tool terminal: the Managed tools registry's, listed under no session."
            },
            "sessionId": {
              "type": "null",
              "description": "Null: a tool terminal names no session."
            },
            "openedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "description": "An instant as an ISO 8601 UTC timestamp."
            },
            "cols": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "description": "A terminal's width in columns, 1 to 1,000."
            },
            "rows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "description": "A terminal's height in rows, 1 to 1,000."
            },
            "exitCode": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ],
              "description": "The shell's exit code once it has exited; null while it runs."
            },
            "signal": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ],
              "description": "The signal that ended the shell, when one did; null otherwise or while it runs."
            }
          },
          "required": [
            "id",
            "owner",
            "sessionId",
            "openedAt",
            "cols",
            "rows",
            "exitCode",
            "signal"
          ],
          "description": "A tool terminal: one install or update command the Managed tools registry runs through the user's login shell."
        }
      ],
      "description": "A terminal: its id, its owner (a session, or the Managed tools registry for a tool terminal, which names no session), when it opened, its size, and its exit code once it has exited."
    }
  },
  "required": [
    "terminal"
  ]
}
