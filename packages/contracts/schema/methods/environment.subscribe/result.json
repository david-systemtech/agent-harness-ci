{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "environment.subscribe result",
  "type": "object",
  "properties": {
    "status": {
      "type": "object",
      "properties": {
        "readiness": {
          "type": "string",
          "enum": [
            "starting",
            "ready",
            "draining"
          ],
          "description": "Whether the environment accepts work: starting (before its startup gate), ready, or draining (refusing new runs before a restart)."
        }
      },
      "required": [
        "readiness"
      ]
    }
  },
  "required": [
    "status"
  ]
}
