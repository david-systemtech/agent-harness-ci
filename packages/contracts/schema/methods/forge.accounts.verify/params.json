{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "forge.accounts.verify params",
  "type": "object",
  "properties": {
    "forgeAccountId": {
      "description": "The forge account to verify; every one when absent.",
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    }
  }
}
