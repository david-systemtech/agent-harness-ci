{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "keyManagers.move.copyValue response",
  "type": "object",
  "properties": {
    "receipt": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "accepted"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "The log's head once the command committed: its last event, or the head it saw when it appended none."
            },
            "changed": {
              "type": "boolean",
              "description": "False for a command that was accepted and changed nothing, so appended no event."
            }
          },
          "required": [
            "status",
            "sequence",
            "changed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "rejected"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "The log's head when the command was rejected."
            },
            "changed": {
              "type": "boolean",
              "const": false
            },
            "reason": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "description": "Why the command was rejected, the code of its error: not_found when its target does not exist."
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "description": "A stable error code in snake case."
                },
                "message": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "code",
                "message",
                "data"
              ],
              "description": "The rejection as an error: its code (the reason), a message for people and structured data."
            }
          },
          "required": [
            "status",
            "sequence",
            "changed",
            "reason",
            "error"
          ]
        }
      ],
      "description": "A command's receipt: accepted (with the head sequence after it and whether it changed anything) or rejected (with the reason and the error). A retry with the same commandId answers the same receipt."
    },
    "result": {
      "description": "The method's result, present when this request applied the command; absent on a retry and on a rejection.",
      "type": "object",
      "properties": {
        "item": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "forge-account",
                "endpoint",
                "bank"
              ],
              "description": "What holds a stored value Move can take: forge-account (a forge account's pasted token), endpoint (a webhook endpoint's pasted secret) or bank (a bank's fallback token)."
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\p{Cc}]+$",
              "description": "The item's id with its owner: a forge account's or bank's id, or a webhook endpoint's name."
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "description": "An item Move takes, by its kind and its owner's id for it."
        },
        "reference": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "const": "openbao"
                    },
                    "connectionId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                      "description": "The key-manager connection the reference is read through."
                    },
                    "mount": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024,
                      "pattern": "^[^/\\p{Cc}]+(?:\\/[^/\\p{Cc}]+)*$",
                      "description": "The KV mount, as personal or secret/team: no slash at either end."
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024,
                      "pattern": "^[^/\\p{Cc}]+(?:\\/[^/\\p{Cc}]+)*$",
                      "description": "The secret's path under the mount, as harness/forge-github."
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\p{Cc}]+$",
                      "description": "The key inside the secret whose value is read."
                    }
                  },
                  "required": [
                    "provider",
                    "connectionId",
                    "mount",
                    "path",
                    "key"
                  ],
                  "description": "A value in OpenBao or Vault: a key of the secret at a path under a KV mount."
                },
                {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "const": "doppler"
                    },
                    "connectionId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                      "description": "The key-manager connection the reference is read through."
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 256,
                      "pattern": "^[A-Z_][A-Z0-9_]*$",
                      "description": "The secret's name: upper-case letters, digits and underscores, not starting with a digit."
                    },
                    "project": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\p{Cc}]+$",
                      "description": "The project, when the connection's token does not fix one."
                    },
                    "config": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\p{Cc}]+$",
                      "description": "The config, when the connection's token does not fix one."
                    }
                  },
                  "required": [
                    "provider",
                    "connectionId",
                    "name"
                  ],
                  "description": "A Doppler secret by name, with its project and config when the token does not fix them."
                },
                {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "const": "onepassword"
                    },
                    "connectionId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                      "description": "The key-manager connection the reference is read through."
                    },
                    "vault": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\p{Cc}]+$",
                      "description": "The vault, by name or id."
                    },
                    "item": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\p{Cc}]+$",
                      "description": "The item, by name or id."
                    },
                    "field": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\p{Cc}]+$",
                      "description": "The field whose value is read."
                    }
                  },
                  "required": [
                    "provider",
                    "connectionId",
                    "vault",
                    "item",
                    "field"
                  ],
                  "description": "A 1Password field, as an op:// reference names it: vault, item and field."
                },
                {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "const": "bitwarden"
                    },
                    "connectionId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                      "description": "The key-manager connection the reference is read through."
                    },
                    "secretId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                      "description": "The secret's id, which is what is read."
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\p{Cc}]+$",
                      "description": "The secret's key, for display only."
                    }
                  },
                  "required": [
                    "provider",
                    "connectionId",
                    "secretId",
                    "key"
                  ],
                  "description": "A Bitwarden Secrets Manager secret by id, with its key for display."
                }
              ],
              "description": "Where a credential sits in a key manager, never its value: the provider, the connection it is read through, and the provider's locator (OpenBao mount, path and key; a Doppler name with its project and config; a 1Password vault, item and field; a Bitwarden secret id with its key)."
            },
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "const": "bitwarden"
                },
                "connectionId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                  "description": "The key-manager connection the reference is read through."
                },
                "project": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\p{Cc}]+$",
                  "description": "The base project name or id."
                },
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\p{Cc}]+$",
                  "description": "The secret key Move writes."
                }
              },
              "required": [
                "provider",
                "connectionId",
                "project",
                "key"
              ]
            }
          ],
          "description": "The target to paste the value at: the reference the item holds once keyManagers.move with verifyOnly has read it back."
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "description": "The item's stored value, unredacted: answered here once, and in no event, receipt or log line."
        }
      },
      "required": [
        "item",
        "reference",
        "value"
      ]
    }
  },
  "required": [
    "receipt"
  ]
}
