{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeliveryAttempt",
  "type": "object",
  "properties": {
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "Which attempt, from 1."
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "An instant as an ISO 8601 UTC timestamp."
    },
    "result": {
      "type": "string",
      "enum": [
        "delivered",
        "retrying",
        "failed"
      ],
      "description": "What a delivery attempt came to: delivered, retrying (it failed and is retried at retryAt: a network error, a timeout, 408, 429 or 5xx) or failed (finally)."
    },
    "status": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        {
          "type": "null"
        }
      ],
      "description": "The HTTP status a webhook answered; null for a client notice, or when none came."
    },
    "error": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "What went wrong; null when it was delivered."
    },
    "retryAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "description": "An instant as an ISO 8601 UTC timestamp."
        },
        {
          "type": "null"
        }
      ],
      "description": "When the next attempt is made, when the result is retrying; else null."
    }
  },
  "required": [
    "attempt",
    "at",
    "result",
    "status",
    "error",
    "retryAt"
  ],
  "description": "One attempt to deliver an entry to a target: which, when, what it came to, the status, the error and the retry time."
}
