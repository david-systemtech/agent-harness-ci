{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionGroupSetPayload",
  "type": "object",
  "properties": {
    "groupId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "description": "A group's id: a UUID the creating client mints, kept in lowercase."
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "groupId"
  ],
  "description": "session.group-set: the session was put in a group, or taken out of one (null)."
}
