{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolEndedPayload",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "description": "A run's id: a version 4 UUID the environment mints when the run starts or is adopted."
    },
    "toolCallId": {
      "type": "string",
      "minLength": 1,
      "description": "The provider's id for the tool call."
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "error",
        "cancelled"
      ],
      "description": "How a tool call ended: ok, error, or cancelled."
    },
    "output": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {}
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      ],
      "description": "The tool's result as the provider reports it, any JSON value."
    },
    "durationMs": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "runId",
    "toolCallId",
    "status",
    "output",
    "durationMs"
  ],
  "description": "tool.ended: a tool call finished."
}
