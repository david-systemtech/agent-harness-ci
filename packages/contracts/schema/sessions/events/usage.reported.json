{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UsageReportedPayload",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "description": "A run's id: a version 4 UUID the environment mints when the run starts or is adopted."
    },
    "models": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "inputTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "outputTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cacheReadTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cacheWriteTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "costUsd": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "description": "What the tokens cost in US dollars, when the provider says."
          },
          "contextWindow": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "The model's context window in tokens, when the provider says."
          }
        },
        "required": [
          "model",
          "inputTokens",
          "outputTokens",
          "cacheReadTokens",
          "cacheWriteTokens",
          "costUsd",
          "contextWindow"
        ],
        "description": "One model's token spend in a run: input, output, cache reads and writes, cost and context window."
      }
    }
  },
  "required": [
    "runId",
    "models"
  ],
  "description": "usage.reported: the run's token spend so far, per model."
}
