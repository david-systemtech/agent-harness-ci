{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionRunChoice",
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "The model, by id."
    },
    "effort": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "The effort; null for the model's own."
    }
  },
  "required": [
    "model",
    "effort"
  ],
  "description": "A model and effort for a session's next run: effort null for the model's own."
}
