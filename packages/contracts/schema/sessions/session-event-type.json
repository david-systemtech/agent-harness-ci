{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionEventType",
  "type": "string",
  "enum": [
    "session.created",
    "session.title-set",
    "session.title-generated",
    "session.archived",
    "session.unarchived",
    "session.pinned",
    "session.unpinned",
    "session.pin-reordered",
    "session.active-reordered",
    "session.tagged",
    "session.untagged",
    "session.draft-set",
    "session.group-set",
    "session.settled",
    "session.unsettled",
    "session.snoozed",
    "session.unsnoozed",
    "session.deleted",
    "session.restored",
    "session.purged",
    "session.pull-request-linked",
    "session.pull-request-unlinked",
    "session.pull-request-synced",
    "run.started",
    "run.ended",
    "message.sent",
    "prompt.opened",
    "prompt.answered"
  ],
  "description": "The event types of a session stream: the session.* organisation events, the forge workstream's pull-request events, and the reserved run.started, run.ended, message.sent, prompt.opened and prompt.answered."
}
