{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PairError",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "pairing_invalid"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {}
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "description": "The pairing code is not one this environment issued."
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "pairing_expired"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {}
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "description": "The pairing code has expired; mint a new one."
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "pairing_used"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {}
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "description": "The pairing code has been exchanged already; each code is single use."
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "protocol_mismatch"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "protocolVersion": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "The environment's own protocol version."
            }
          },
          "required": [
            "protocolVersion"
          ]
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "description": "The client's protocol version is not the environment's, named in data; the code is not spent."
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "invalid_params"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "path": {
                    "type": "array",
                    "items": {
                      "type": [
                        "string",
                        "number"
                      ]
                    }
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "path",
                  "message"
                ],
                "additionalProperties": {},
                "description": "One schema issue: a code, the path to the offending value and a message."
              }
            }
          },
          "required": [
            "issues"
          ]
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "description": "The params or the frame did not match the schema; data.issues lists the schema's issues."
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "rate_limited"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "retryAfterMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Milliseconds until the next exchange is taken."
            }
          },
          "required": [
            "retryAfterMs"
          ]
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "description": "Too many exchanges from this address; data.retryAfterMs says when to try again."
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "unavailable"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "readiness": {
              "type": "string",
              "enum": [
                "starting",
                "draining"
              ],
              "description": "Why the environment cannot answer: it is not ready yet, or it is draining."
            }
          },
          "required": [
            "readiness"
          ]
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "description": "The environment is starting or draining; data.readiness says which."
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "internal"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {}
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "description": "The environment failed; nothing the client sent is at fault."
    }
  ],
  "description": "Why a pairing exchange was refused."
}
