{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BridgePaired",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "paired"
    },
    "chromeId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "A paired Chrome's id: a UUID its environment mints when it pairs."
    },
    "secret": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "The Chrome's secret: 32 random bytes as 64 lowercase hex characters, kept by the extension and never sent again."
    },
    "policy": {
      "type": "object",
      "properties": {
        "devSites": {
          "type": "array",
          "items": {
            "type": "string",
            "allOf": [
              {
                "pattern": "^(?:(?:\\*\\.)?[A-Za-z0-9_](?:[A-Za-z0-9_-]{0,61}[A-Za-z0-9_])?(?:\\.[A-Za-z0-9_](?:[A-Za-z0-9_-]{0,61}[A-Za-z0-9_])?)*|(?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){6}(?:\\d{1,3}\\.){3}\\d{1,3}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?::[0-9A-Fa-f]{1,4}){1,6}|:(?:(?::[0-9A-Fa-f]{1,4}){1,7}|:)|::(?:[0-9A-Fa-f]{1,4}:){0,5}(?:\\d{1,3}\\.){3}\\d{1,3}|(?:[0-9A-Fa-f]{1,4}:){0}[0-9A-Fa-f]{1,4}::(?:[0-9A-Fa-f]{1,4}:){0,4}(?:\\d{1,3}\\.){3}\\d{1,3}|(?:[0-9A-Fa-f]{1,4}:){1}[0-9A-Fa-f]{1,4}::(?:[0-9A-Fa-f]{1,4}:){0,3}(?:\\d{1,3}\\.){3}\\d{1,3}|(?:[0-9A-Fa-f]{1,4}:){2}[0-9A-Fa-f]{1,4}::(?:[0-9A-Fa-f]{1,4}:){0,2}(?:\\d{1,3}\\.){3}\\d{1,3}|(?:[0-9A-Fa-f]{1,4}:){3}[0-9A-Fa-f]{1,4}::(?:[0-9A-Fa-f]{1,4}:){0,1}(?:\\d{1,3}\\.){3}\\d{1,3}|(?:[0-9A-Fa-f]{1,4}:){4}[0-9A-Fa-f]{1,4}::(?:[0-9A-Fa-f]{1,4}:){0,0}(?:\\d{1,3}\\.){3}\\d{1,3})$"
              },
              {
                "pattern": "^(?!(?:\\*\\.)?[0-9.]+$)|^(?:\\*\\.)?(?:(?:(?!0[0-9])(?:[0-9]{1,9}|4294967295|[0-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})|0+(?:[0-7]{1,10}|37777777777|[0-2][0-7]{10}|3[0-6][0-7]{9}|37[0-6][0-7]{8}|377[0-6][0-7]{7}|3777[0-6][0-7]{6}|37777[0-6][0-7]{5}|377777[0-6][0-7]{4}|3777777[0-6][0-7]{3}|37777777[0-6][0-7]{2}|377777777[0-6][0-7]{1}|3777777777[0-6][0-7]{0}))|(?:(?!0[0-9])(?:[0-9]{1,2}|255|[0-1][0-9]{2}|2[0-4][0-9]{1}|25[0-4][0-9]{0})|0+(?:[0-7]{1,2}|377|[0-2][0-7]{2}|3[0-6][0-7]{1}|37[0-6][0-7]{0}))\\.(?:(?!0[0-9])(?:[0-9]{1,7}|16777215|0[0-9]{7}|1[0-5][0-9]{6}|16[0-6][0-9]{5}|167[0-6][0-9]{4}|1677[0-6][0-9]{3}|16777[0-1][0-9]{2}|1677720[0-9]{1}|1677721[0-4][0-9]{0})|0+(?:[0-7]{1,7}|77777777|[0-6][0-7]{7}|7[0-6][0-7]{6}|77[0-6][0-7]{5}|777[0-6][0-7]{4}|7777[0-6][0-7]{3}|77777[0-6][0-7]{2}|777777[0-6][0-7]{1}|7777777[0-6][0-7]{0}))|(?:(?!0[0-9])(?:[0-9]{1,2}|255|[0-1][0-9]{2}|2[0-4][0-9]{1}|25[0-4][0-9]{0})|0+(?:[0-7]{1,2}|377|[0-2][0-7]{2}|3[0-6][0-7]{1}|37[0-6][0-7]{0}))\\.(?:(?!0[0-9])(?:[0-9]{1,2}|255|[0-1][0-9]{2}|2[0-4][0-9]{1}|25[0-4][0-9]{0})|0+(?:[0-7]{1,2}|377|[0-2][0-7]{2}|3[0-6][0-7]{1}|37[0-6][0-7]{0}))\\.(?:(?!0[0-9])(?:[0-9]{1,4}|65535|[0-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|0+(?:[0-7]{1,5}|177777|0[0-7]{5}|1[0-6][0-7]{4}|17[0-6][0-7]{3}|177[0-6][0-7]{2}|1777[0-6][0-7]{1}|17777[0-6][0-7]{0}))|(?:(?!0[0-9])(?:[0-9]{1,2}|255|[0-1][0-9]{2}|2[0-4][0-9]{1}|25[0-4][0-9]{0})|0+(?:[0-7]{1,2}|377|[0-2][0-7]{2}|3[0-6][0-7]{1}|37[0-6][0-7]{0}))\\.(?:(?!0[0-9])(?:[0-9]{1,2}|255|[0-1][0-9]{2}|2[0-4][0-9]{1}|25[0-4][0-9]{0})|0+(?:[0-7]{1,2}|377|[0-2][0-7]{2}|3[0-6][0-7]{1}|37[0-6][0-7]{0}))\\.(?:(?!0[0-9])(?:[0-9]{1,2}|255|[0-1][0-9]{2}|2[0-4][0-9]{1}|25[0-4][0-9]{0})|0+(?:[0-7]{1,2}|377|[0-2][0-7]{2}|3[0-6][0-7]{1}|37[0-6][0-7]{0}))\\.(?:(?!0[0-9])(?:[0-9]{1,2}|255|[0-1][0-9]{2}|2[0-4][0-9]{1}|25[0-4][0-9]{0})|0+(?:[0-7]{1,2}|377|[0-2][0-7]{2}|3[0-6][0-7]{1}|37[0-6][0-7]{0})))$"
              }
            ],
            "description": "A host name, IPv4 address or IPv6 literal, with an optional leading wildcard label (*.example.com): no scheme, port or path. All-digit names must be valid IPv4 spellings."
          },
          "description": "browser.devSites: the hosts being developed, as host patterns, where cookie values, storage and evaluate are allowed; loopback, private, link-local, CGNAT and unique-local addresses and .local, .internal and .lan names count without being listed, a cloud metadata address never."
        },
        "evaluateEverywhere": {
          "type": "boolean",
          "description": "browser.evaluateEverywhere: evaluate is allowed on every site, not only dev sites."
        },
        "deepReadEverywhere": {
          "type": "boolean",
          "description": "browser.deepReadEverywhere: cookie values and storage are read on every site, not only dev sites."
        },
        "browserDomains": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "The entry's id, unique in its section: a preset's is the same on every environment."
              },
              "pattern": {
                "type": "string",
                "minLength": 1,
                "description": "The pattern, in its section's grammar."
              },
              "note": {
                "type": "string",
                "maxLength": 500,
                "description": "Why the entry is there, for people; empty for none."
              },
              "preset": {
                "type": "boolean",
                "description": "Whether it came from the presets (seeded on first start, or restored); an edited preset keeps it."
              },
              "enabled": {
                "type": "boolean",
                "description": "Whether it matches: a disabled entry never does."
              }
            },
            "required": [
              "id",
              "pattern",
              "note",
              "preset",
              "enabled"
            ],
            "description": "One entry of the denylist: its id, pattern, note, whether it is a preset, and whether it is enabled."
          },
          "description": "The enabled entries of the denylist's browser section, in its order: where no verb goes unasked. A disabled entry never matches."
        }
      },
      "required": [
        "devSites",
        "evaluateEverywhere",
        "deepReadEverywhere",
        "browserDomains"
      ],
      "description": "The page policy a paired Chrome enforces: the dev sites, the two everywhere switches and the enabled entries of the denylist's browser section. The Chrome Web Store is refused under every policy."
    }
  },
  "required": [
    "type",
    "chromeId",
    "secret",
    "policy"
  ],
  "description": "paired: the code was good; the Chrome's id, its secret and the page policy."
}
