{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BridgeAnnounced",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "announced"
    },
    "environmentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "An environment's persistent id: a UUID made on its first start, kept across address changes."
    },
    "environmentName": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "type",
    "environmentId",
    "environmentName"
  ],
  "description": "announced: the environment's answer to announce, its id and name; the socket is kept for pair."
}
