{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WaitForArgs",
  "type": "object",
  "properties": {
    "until": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "timeoutMs": {
              "description": "How long to wait, in milliseconds; preset 10000, clamped to 30000.",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "description": "Until this text appears on the page."
        },
        {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "A ref a snapshot gave an element (e12, prefixed for a child frame's elements)."
            },
            "timeoutMs": {
              "description": "How long to wait, in milliseconds; preset 10000, clamped to 30000.",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "ref"
          ],
          "additionalProperties": false,
          "description": "Until an element with this ref exists."
        },
        {
          "type": "object",
          "properties": {
            "ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Milliseconds, clamped to 30000."
            }
          },
          "required": [
            "ms"
          ],
          "additionalProperties": false,
          "description": "For this long."
        }
      ],
      "description": "What to wait for: text, a ref, or a number of milliseconds."
    }
  },
  "required": [
    "until"
  ],
  "description": "waitFor: text, a ref or a number of milliseconds."
}
