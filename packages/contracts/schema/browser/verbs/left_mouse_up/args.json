{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LeftMouseUpArgs",
  "type": "object",
  "properties": {
    "target": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "coordinate"
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "x",
        "y"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "target"
  ],
  "description": "left_mouse_up: release the left button at a viewport coordinate."
}
