{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LeftClickDragArgs",
  "type": "object",
  "properties": {
    "from": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "coordinate"
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "coordinate"
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "description": "Answer with a snapshot of the page after the action, read as these arguments say; none when absent.",
      "type": "object",
      "properties": {
        "filter": {
          "description": "interactive (preset): the elements that can be acted on and their context; all: every element.",
          "type": "string",
          "enum": [
            "interactive",
            "all"
          ]
        },
        "depth": {
          "description": "How many levels of the tree to read.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ref": {
          "description": "Read only the subtree of the element with this ref.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "maxChars": {
          "description": "The most characters to answer, cut at the last line boundary within them, or mid-line when no line ends within them; preset 30000, at most 200000.",
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        }
      }
    }
  },
  "required": [
    "from",
    "target"
  ],
  "description": "left_click_drag: press at from, drag to target, and release."
}
