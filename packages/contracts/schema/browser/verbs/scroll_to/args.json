{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScrollToArgs",
  "type": "object",
  "properties": {
    "target": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ref"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "A ref a snapshot gave an element (e12, prefixed for a child frame's elements)."
        }
      },
      "required": [
        "type",
        "ref"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "target"
  ],
  "description": "scroll_to: scroll a snapshot ref into view."
}
