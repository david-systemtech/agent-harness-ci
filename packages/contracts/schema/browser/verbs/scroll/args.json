{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScrollArgs",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "to": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "direction": {
                  "type": "string",
                  "enum": [
                    "up",
                    "down",
                    "left",
                    "right"
                  ],
                  "description": "Which way to scroll."
                },
                "amount": {
                  "description": "How far, in viewports; preset 1.",
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "direction"
              ],
              "additionalProperties": false,
              "description": "A direction and an amount."
            },
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "description": "A ref a snapshot gave an element (e12, prefixed for a child frame's elements)."
                }
              },
              "required": [
                "ref"
              ],
              "additionalProperties": false,
              "description": "Scroll the element with this ref into view."
            }
          ],
          "description": "Where to scroll: a direction and an amount in viewports, or to an element."
        }
      },
      "required": [
        "to"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "target": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "coordinate"
            },
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "scroll_direction": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "left",
            "right"
          ],
          "description": "Which way to turn the wheel at the target coordinate."
        },
        "scroll_amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [
        "target",
        "scroll_direction"
      ],
      "additionalProperties": false
    }
  ],
  "description": "scroll: wheel at a viewport coordinate (1 to 10 notches, preset 3); also accepts the existing viewport/ref target."
}
