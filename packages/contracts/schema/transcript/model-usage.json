{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelUsage",
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1
    },
    "inputTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "outputTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cacheReadTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cacheWriteTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "costUsd": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ],
      "description": "What the tokens cost in US dollars, when the provider says."
    },
    "contextWindow": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ],
      "description": "The model's context window in tokens, when the provider says."
    }
  },
  "required": [
    "model",
    "inputTokens",
    "outputTokens",
    "cacheReadTokens",
    "cacheWriteTokens",
    "costUsd",
    "contextWindow"
  ],
  "description": "One model's token spend in a run: input, output, cache reads and writes, cost and context window."
}
