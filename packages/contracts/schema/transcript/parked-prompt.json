{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ParkedPrompt",
  "type": "object",
  "properties": {
    "promptId": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "The sequence of its prompt.opened."
    },
    "openedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "An instant as an ISO 8601 UTC timestamp."
    },
    "prompt": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {},
      "description": "The prompt.opened payload as it is; its shape is the permissions workstream's (#130)."
    }
  },
  "required": [
    "promptId",
    "sequence",
    "openedAt",
    "prompt"
  ],
  "description": "A prompt a run is parked on, unanswered: its id, when it was opened, and what it asks."
}
