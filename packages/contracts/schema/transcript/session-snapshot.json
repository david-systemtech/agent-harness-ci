{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionSnapshot",
  "type": "object",
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "The log's head the snapshot was read at."
    },
    "summary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
          "description": "A session's id: a version 4 UUID the creating client mints (never the provider's resume id), kept in lowercase."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "description": "An instant as an ISO 8601 UTC timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "description": "The last organisation change; setting the draft is not one."
        },
        "lastActivityAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "description": "An instant as an ISO 8601 UTC timestamp."
            },
            {
              "type": "null"
            }
          ],
          "description": "The last run start, run end, user message or prompt answer; null before any."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Never empty: the user's title, else the generated title, else \"New session\"."
        },
        "titleSource": {
          "type": "string",
          "enum": [
            "user",
            "generated",
            "default"
          ],
          "description": "Where a session's title came from: user (sessions.rename), generated (from the first prompt or the provider), default (\"New session\")."
        },
        "archivedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "description": "An instant as an ISO 8601 UTC timestamp."
            },
            {
              "type": "null"
            }
          ]
        },
        "pinnedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "description": "An instant as an ISO 8601 UTC timestamp."
            },
            {
              "type": "null"
            }
          ]
        },
        "pinOrderKey": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[abcdefghijklmnopqrstuvwxyz]*[bcdefghijklmnopqrstuvwxyz]$",
              "description": "A fractional order key: letters a to z compared as plain strings, never empty and never ending in a, so a key can always be made before any other."
            },
            {
              "type": "null"
            }
          ]
        },
        "activeOrderKey": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[abcdefghijklmnopqrstuvwxyz]*[bcdefghijklmnopqrstuvwxyz]$",
              "description": "A fractional order key: letters a to z compared as plain strings, never empty and never ending in a, so a key can always be made before any other."
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\s*[^\\s\\p{Cc}](?:\\P{Cc}{0,38}[^\\s\\p{Cc}])?\\s*$",
            "description": "A free-form tag: 1 to 40 characters once trimmed, no control characters; stored trimmed, unique per session ignoring case."
          },
          "description": "The session's tags, sorted ignoring case."
        },
        "groupId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
              "description": "A group's id: a version 4 UUID the creating client mints, kept in lowercase."
            },
            {
              "type": "null"
            }
          ],
          "description": "The group on the same environment the session is in, or null."
        },
        "settledAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "description": "An instant as an ISO 8601 UTC timestamp."
            },
            {
              "type": "null"
            }
          ]
        },
        "settledOverride": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "settled",
                "active"
              ],
              "description": "What a settle or an unsettle holds a session to: settled, or active (auto-settle is blocked until the next activity clears it)."
            },
            {
              "type": "null"
            }
          ]
        },
        "settledBy": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "user",
                "auto-idle",
                "auto-merge"
              ],
              "description": "Who settled a session: user, auto-idle (quiet past the idle span), auto-merge (its pull request merged)."
            },
            {
              "type": "null"
            }
          ]
        },
        "unsettledAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "description": "An instant as an ISO 8601 UTC timestamp."
            },
            {
              "type": "null"
            }
          ]
        },
        "snoozedUntil": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "description": "An instant as an ISO 8601 UTC timestamp."
            },
            {
              "type": "null"
            }
          ]
        },
        "snoozedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "description": "An instant as an ISO 8601 UTC timestamp."
            },
            {
              "type": "null"
            }
          ]
        },
        "workspace": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "directory"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The directory on the environment's machine."
                }
              },
              "required": [
                "kind",
                "path"
              ],
              "description": "A directory the environment has."
            }
          ],
          "description": "Where a session's code lives on its environment: its kind and path."
        },
        "repositoryIdentity": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "The canonical remote URL of the repository the workspace belongs to; null outside a repository or until it is resolved."
        },
        "activity": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "idle",
                "starting",
                "running",
                "parked"
              ],
              "description": "What a session's runs are doing: idle (no run), starting, running, or parked (a run is waiting on a prompt nobody has answered)."
            },
            "since": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "description": "An instant as an ISO 8601 UTC timestamp."
            }
          },
          "required": [
            "state",
            "since"
          ],
          "description": "What a session's runs are doing, and since when; a new session is idle since it was created."
        },
        "parkedPromptCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Prompts a run of the session is parked on, unanswered."
        },
        "accountId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "The account the latest run used; null before any run."
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "The model the latest run used; null before any run."
        },
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "plan",
                "acceptEdits",
                "auto",
                "bypassPermissions"
              ],
              "description": "What an agent may do without asking during a run, in the order ceilings use: plan < acceptEdits < auto < bypassPermissions. Claude's default and dontAsk are never used."
            },
            {
              "type": "null"
            }
          ],
          "description": "The session's mode: the effective mode permissions.mode.set last gave it, else the one sessions.create recorded (clamped to its caller's ceiling); null when neither did, so a run's default applies. Each run clamps it again."
        },
        "pullRequests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "state": {
                "type": "string",
                "enum": [
                  "open",
                  "closed",
                  "merged"
                ],
                "description": "A pull request's state: open, closed (without merging) or merged."
              },
              "mergedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                    "description": "An instant as an ISO 8601 UTC timestamp."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "closedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                    "description": "An instant as an ISO 8601 UTC timestamp."
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "url",
              "state",
              "mergedAt",
              "closedAt"
            ],
            "description": "A pull request linked to a session: its url, state, and when it merged or closed."
          }
        },
        "draft": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536,
              "description": "A session's composer draft as sent: the text typed and not sent, up to 65536 characters counted as UTF-16 code units; an empty draft is stored as none (null)."
            },
            {
              "type": "null"
            }
          ],
          "description": "A session's composer draft as stored: the text typed and not sent, 1 to 65536 characters counted as UTF-16 code units, or null when there is none."
        }
      },
      "required": [
        "id",
        "createdAt",
        "updatedAt",
        "lastActivityAt",
        "title",
        "titleSource",
        "archivedAt",
        "pinnedAt",
        "pinOrderKey",
        "activeOrderKey",
        "tags",
        "groupId",
        "settledAt",
        "settledOverride",
        "settledBy",
        "unsettledAt",
        "snoozedUntil",
        "snoozedAt",
        "workspace",
        "repositoryIdentity",
        "activity",
        "parkedPromptCount",
        "accountId",
        "model",
        "mode",
        "pullRequests",
        "draft"
      ],
      "description": "A session as every client renders its list row: identity, title, filing, shelf, place, activity, forge and the composer draft."
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
            "description": "A run's id: a version 4 UUID the environment mints when the run starts or is adopted."
          },
          "state": {
            "type": "string",
            "enum": [
              "running",
              "ended"
            ],
            "description": "Where a run is: running (started, not ended) or ended."
          },
          "origin": {
            "type": "string",
            "enum": [
              "client",
              "routine",
              "completions",
              "provider"
            ],
            "description": "Where a run came from: client (runs.start or runs.send, or the environment's queue after a client's run), routine, completions, or provider (a turn the provider opened itself, adopted as a run)."
          },
          "accountId": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "mode": {
            "type": "object",
            "properties": {
              "requested": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "plan",
                      "acceptEdits",
                      "auto",
                      "bypassPermissions"
                    ],
                    "description": "What an agent may do without asking during a run, in the order ceilings use: plan < acceptEdits < auto < bypassPermissions. Claude's default and dontAsk are never used."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The mode asked for, by the command or the session; null when neither names one, so a default applied."
              },
              "effective": {
                "type": "string",
                "enum": [
                  "plan",
                  "acceptEdits",
                  "auto",
                  "bypassPermissions"
                ],
                "description": "The mode the run got, after the clamp to the client session's ceiling and the account's modes."
              },
              "clamped": {
                "type": "boolean",
                "description": "Whether the clamp lowered the mode asked for; run.policy.resolved says why."
              }
            },
            "required": [
              "requested",
              "effective",
              "clamped"
            ],
            "description": "A run's mode: requested, effective after the ceiling's clamp, and whether it was clamped; run.policy.resolved has the rest."
          },
          "promptMessageId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                "description": "A user message's id: a version 4 UUID the environment mints when a client sends it, and the id the provider is handed."
              },
              {
                "type": "null"
              }
            ]
          },
          "queuedMessageIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
              "description": "A user message's id: a version 4 UUID the environment mints when a client sends it, and the id the provider is handed."
            }
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "An instant as an ISO 8601 UTC timestamp."
          },
          "endedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                "description": "An instant as an ISO 8601 UTC timestamp."
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "completed",
                  "error",
                  "interrupted",
                  "disposed",
                  "drained"
                ],
                "description": "Why a run ended: completed, error, interrupted (with its cause), disposed (the environment let the run go: its session was deleted, or the environment closed), drained (cut by a drain's cap)."
              },
              {
                "type": "null"
              }
            ]
          },
          "cause": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "user",
                  "read-now",
                  "restart",
                  "parked"
                ],
                "description": "What interrupted a run: user (runs.interrupt), read-now, restart (the recovery sweep after a restart), parked (its process was stopped while parked on a prompt)."
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "code": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The provider's or the environment's code for it, when there is one."
                  }
                },
                "required": [
                  "message",
                  "code"
                ],
                "description": "What went wrong in a run: a message and, when there is one, a code."
              },
              {
                "type": "null"
