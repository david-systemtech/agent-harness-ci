{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResponseFrame",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "response"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "A request's id, chosen by the client and echoed by its response."
        },
        "result": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "error": {
          "not": {}
        }
      },
      "required": [
        "type",
        "id",
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "response"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "A request's id, chosen by the client and echoed by its response."
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "description": "A stable error code in snake case."
            },
            "message": {
              "type": "string"
            },
            "data": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "code",
            "message",
            "data"
          ],
          "description": "An error as a response carries it: a stable code, a message and structured data."
        },
        "result": {
          "not": {}
        }
      },
      "required": [
        "type",
        "id",
        "error"
      ]
    }
  ],
  "description": "From the environment: a request's result, or its error, never both."
}
