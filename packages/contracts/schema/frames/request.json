{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RequestFrame",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "request"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "A request's id, chosen by the client and echoed by its response."
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "params": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "type",
    "id",
    "method",
    "params"
  ],
  "description": "Client: call a method, or subscribe when the method is a stream."
}
