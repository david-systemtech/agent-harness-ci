{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EndFrame",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "end"
    },
    "subscription": {
      "type": "string",
      "minLength": 1,
      "description": "A subscription's id, chosen by the environment and carried by every subscription message."
    },
    "reason": {
      "type": "string",
      "enum": [
        "unsubscribed",
        "overflow",
        "revoked",
        "closed"
      ]
    }
  },
  "required": [
    "type",
    "subscription",
    "reason"
  ],
  "description": "Server: the subscription is over, and why."
}
