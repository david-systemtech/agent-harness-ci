{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ByeFrame",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "bye"
    },
    "reason": {
      "type": "string",
      "enum": [
        "unauthorized",
        "expired",
        "revoked",
        "protocol",
        "draining",
        "updating"
      ]
    },
    "protocolVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "A wire protocol version: one integer, bumped only on a breaking change."
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "reason"
  ],
  "description": "Server, before it closes the connection: why, so the client reconnects only when it should."
}
