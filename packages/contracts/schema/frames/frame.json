{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frame",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "auth"
        },
        "token": {
          "type": "string",
          "minLength": 1
        },
        "protocolVersion": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "A wire protocol version: one integer, bumped only on a breaking change."
        },
        "clientKind": {
          "type": "string",
          "enum": [
            "desktop",
            "tui",
            "web",
            "program"
          ],
          "description": "What kind of client a client session belongs to."
        },
        "harnessVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "token",
        "protocolVersion",
        "clientKind",
        "harnessVersion"
      ],
      "description": "Client, first message: the client session token, the client's protocol version, kind and harness version."
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        },
        "protocolVersion": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "A wire protocol version: one integer, bumped only on a breaking change."
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "One capability an environment offers."
          },
          "uniqueItems": true,
          "description": "The capabilities an environment offers, as a set; an absent flag means unsupported."
        },
        "environmentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "environmentName": {
          "type": "string"
        },
        "clientSessionId": {
          "type": "string",
          "minLength": 1
        },
        "scopes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read",
              "sessions:write",
              "runs:drive",
              "terminal",
              "admin"
            ],
            "description": "One of the five scopes a method may require."
          },
          "uniqueItems": true,
          "description": "The scopes a client session holds, as a non-empty set."
        },
        "ceiling": {
          "type": "string",
          "minLength": 1,
          "description": "The highest mode a client session may use; its values are the permissions workstream's."
        },
        "serverTime": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "description": "An instant as an ISO 8601 UTC timestamp."
        }
      },
      "required": [
        "type",
        "protocolVersion",
        "capabilities",
        "environmentId",
        "environmentName",
        "clientSessionId",
        "scopes",
        "ceiling",
        "serverTime"
      ],
      "description": "Server, in reply to a valid auth: what the environment is and what this client session may do."
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "request"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "A request's id, chosen by the client and echoed by its response."
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "type",
        "id",
        "method",
        "params"
      ],
      "description": "Client: call a method, or subscribe when the method is a stream."
    },
    {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "response"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "A request's id, chosen by the client and echoed by its response."
            },
            "result": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "type",
            "id",
            "result"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "response"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "A request's id, chosen by the client and echoed by its response."
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "description": "A stable error code in snake case."
                },
                "message": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "code",
                "message",
                "data"
              ],
              "description": "An error as a response carries it: a stable code, a message and structured data."
            }
          },
          "required": [
            "type",
            "id",
            "error"
          ]
        }
      ],
      "description": "Server: a request's result, or its error."
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "subscribed"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "A request's id, chosen by the client and echoed by its response."
        },
        "subscription": {
          "type": "string",
          "minLength": 1,
          "description": "A subscription's id, chosen by the environment and carried by every subscription message."
        }
      },
      "required": [
        "type",
        "id",
        "subscription"
      ],
      "description": "Server: the response to a stream request, naming the subscription its messages carry."
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "snapshot"
        },
        "subscription": {
          "type": "string",
          "minLength": 1,
          "description": "A subscription's id, chosen by the environment and carried by every subscription message."
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "A position in the event log's global sequence; 0 is the cursor before the first event."
        },
        "payload": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "type",
        "subscription",
        "sequence",
        "payload"
      ],
      "description": "Server: at most one, first, when replay from the cursor is out of bounds; the state as of sequence."
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "event"
        },
        "subscription": {
          "type": "string",
          "minLength": 1,
          "description": "A subscription's id, chosen by the environment and carried by every subscription message."
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "A position in the event log's global sequence; 0 is the cursor before the first event."
        },
        "event": {
          "type": "object",
          "properties": {
            "sequence": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "eventId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "streamKind": {
              "type": "string",
              "minLength": 1
            },
            "streamId": {
              "type": "string",
              "minLength": 1
            },
            "streamVersion": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "type": {
              "type": "string",
              "minLength": 1
            },
            "occurredAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "description": "An instant as an ISO 8601 UTC timestamp."
            },
            "commandId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "description": "The client-generated UUID every mutating method takes; a retry with the same id applies once."
                },
                {
                  "type": "null"
                }
              ]
            },
            "causationId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "correlationId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "actor": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "client_session",
                    "routine",
                    "adapter",
                    "system"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "description": "Who caused an event: a client session, routine, adapter or system component."
            },
            "payload": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "metadata": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "sequence",
            "eventId",
            "streamKind",
            "streamId",
            "streamVersion",
            "type",
            "occurredAt",
            "commandId",
            "causationId",
            "correlationId",
            "actor",
            "payload",
            "metadata"
          ],
          "description": "One event on the environment's log, as every stream carries it."
        }
      },
      "required": [
        "type",
        "subscription",
        "sequence",
        "event"
      ],
      "description": "Server: one event of the subscription's stream."
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "synchronized"
        },
        "subscription": {
          "type": "string",
          "minLength": 1,
          "description": "A subscription's id, chosen by the environment and carried by every subscription message."
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "A position in the event log's global sequence; 0 is the cursor before the first event."
        }
      },
      "required": [
        "type",
        "subscription",
        "sequence"
      ],
      "description": "Server: once, when catch-up is complete; live events follow."
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "end"
        },
        "subscription": {
          "type": "string",
          "minLength": 1,
          "description": "A subscription's id, chosen by the environment and carried by every subscription message."
        },
        "reason": {
          "type": "string",
          "enum": [
            "unsubscribed",
            "overflow",
            "revoked",
            "closed"
          ]
        }
      },
      "required": [
        "type",
        "subscription",
        "reason"
      ],
      "description": "Server: the subscription is over, and why."
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "unsubscribe"
        },
        "subscription": {
          "type": "string",
          "minLength": 1,
          "description": "A subscription's id, chosen by the environment and carried by every subscription message."
        }
      },
      "required": [
        "type",
        "subscription"
      ],
      "description": "Client: end a subscription; answered by end with reason unsubscribed."
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ping"
        }
      },
      "required": [
        "type"
      ],
      "description": "Server, every 15 seconds; a client arms its 45-second watchdog after the first."
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "pong"
        }
      },
      "required": [
        "type"
      ],
      "description": "The answer to a ping."
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "bye"
        },
        "reason": {
          "type": "string",
          "enum": [
            "unauthorized",
            "expired",
            "revoked",
            "protocol",
            "draining",
            "updating"
          ]
        },
        "protocolVersion": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "A wire protocol version: one integer, bumped only on a breaking change."
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "reason"
      ],
      "description": "Server, before it closes the connection: why, so the client reconnects only when it should."
    }
  ],
  "description": "Any frame on the wire, told apart by its type."
}
