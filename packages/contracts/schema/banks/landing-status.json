{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BankLandingStatus",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "ok"
        },
        "since": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "description": "When this part of the status last changed: never when it was last verified."
        }
      },
      "required": [
        "state",
        "since"
      ]
    },
    {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "failed"
        },
        "step": {
          "type": "string",
          "minLength": 1,
          "description": "The Lander's step the landing failed at."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Why, in a sentence."
        },
        "since": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "description": "When this part of the status last changed: never when it was last verified."
        }
      },
      "required": [
        "state",
        "step",
        "reason",
        "since"
      ]
    }
  ],
  "description": "The bank's last landing: ok (none failed), or failed at a step of the Lander, with why."
}
