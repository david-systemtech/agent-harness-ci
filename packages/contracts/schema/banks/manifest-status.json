{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BankManifestStatus",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "valid"
        },
        "since": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "description": "When this part of the status last changed: never when it was last verified."
        }
      },
      "required": [
        "state",
        "since"
      ]
    },
    {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "awaiting-review"
        },
        "pullRequest": {
          "type": "string",
          "minLength": 1,
          "description": "The web address of the open pull request holding BANK.md."
        },
        "since": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "description": "When this part of the status last changed: never when it was last verified."
        }
      },
      "required": [
        "state",
        "pullRequest",
        "since"
      ]
    },
    {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "missing"
        },
        "since": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "description": "When this part of the status last changed: never when it was last verified."
        }
      },
      "required": [
        "state",
        "since"
      ]
    },
    {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "invalid"
        },
        "rule": {
          "type": "string",
          "minLength": 1,
          "description": "The validator rule's id it fails first."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "description": "The rule's message."
        },
        "since": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "description": "When this part of the status last changed: never when it was last verified."
        }
      },
      "required": [
        "state",
        "rule",
        "message",
        "since"
      ]
    }
  ],
  "description": "The bank's BANK.md on main: valid; held by an open pull request on a bank whose merges are reviewed (awaiting-review, which counts as landed, ADR 0019); missing; or invalid, with the first rule it fails."
}
