{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BankReviewHeldPayload",
  "type": "object",
  "properties": {
    "bankId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "description": "A bank's id: a version 4 UUID the registering client mints, kept in lowercase."
    },
    "sessionId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
          "description": "A session's id: a version 4 UUID the creating client mints (never the provider's resume id), kept in lowercase."
        },
        {
          "type": "null"
        }
      ]
    },
    "pullRequest": {
      "type": "string",
      "minLength": 1
    },
    "number": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "writes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "drafts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "draft"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "removePaths": {
                "description": "Prior paths of this name removed when the draft moves to a different scope or topic.",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "name",
              "path",
              "content"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "retire"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "removePaths": {
                "description": "Prior paths removed by queued moves of this name.",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "name",
              "path",
              "reason"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "bankId",
    "sessionId",
    "pullRequest",
    "number",
    "head",
    "writes",
    "drafts"
  ]
}
