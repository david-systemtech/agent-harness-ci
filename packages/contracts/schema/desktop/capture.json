{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DesktopCapture",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "mimeType": {
          "type": "string",
          "enum": [
            "image/png",
            "image/jpeg"
          ],
          "description": "The image's type."
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "data": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$",
          "description": "The image, base64."
        }
      },
      "required": [
        "mimeType",
        "width",
        "height",
        "data"
      ],
      "description": "An image of the display or a region, with its pixel size."
    },
    "geometry": {
      "type": "object",
      "properties": {
        "displayId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "The display the driver captures and drives."
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "originX": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "The display's left edge on the virtual desktop."
        },
        "originY": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "The display's top edge on the virtual desktop."
        }
      },
      "required": [
        "displayId",
        "width",
        "height",
        "originX",
        "originY"
      ],
      "description": "The captured display's physical size and its place on the virtual desktop; a change invalidates the screenshot mapping."
    }
  },
  "required": [
    "image",
    "geometry"
  ],
  "description": "A full-display screenshot, downsampled to the long edge, and the display it was taken of: image pixels per physical pixel is the mapping's scale."
}
