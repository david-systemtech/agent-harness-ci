{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DesktopCommand",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "geometry"
        },
        "args": {
          "type": "object",
          "properties": {}
        }
      },
      "required": [
        "operation",
        "args"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "capture"
        },
        "args": {
          "type": "object",
          "properties": {
            "longEdge": {
              "type": "integer",
              "minimum": 64,
              "maximum": 8192,
              "description": "The longest edge the image may have, in pixels; the aspect ratio is kept."
            }
          },
          "required": [
            "longEdge"
          ]
        }
      },
      "required": [
        "operation",
        "args"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "zoom"
        },
        "args": {
          "type": "object",
          "properties": {
            "region": {
              "type": "object",
              "properties": {
                "x0": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "y0": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "x1": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "y1": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "x0",
                "y0",
                "x1",
                "y1"
              ],
              "description": "A physical region of the display, x1 > x0 and y1 > y0."
            },
            "longEdge": {
              "type": "integer",
              "minimum": 64,
              "maximum": 8192,
              "description": "The longest edge the image may have, in pixels; the aspect ratio is kept."
            }
          },
          "required": [
            "region",
            "longEdge"
          ]
        }
      },
      "required": [
        "operation",
        "args"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "cursor"
        },
        "args": {
          "type": "object",
          "properties": {}
        }
      },
      "required": [
        "operation",
        "args"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "click"
        },
        "args": {
          "type": "object",
          "properties": {
            "button": {
              "type": "string",
              "enum": [
                "left",
                "right",
                "middle"
              ],
              "description": "Which mouse button: left, right or middle."
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "at": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "x",
                "y"
              ],
              "description": "A point on the display, in physical pixels from its top-left."
            },
            "modifiers": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "description": "Modifier keys held during the action."
            }
          },
          "required": [
            "button",
            "count",
            "modifiers"
          ]
        }
      },
      "required": [
        "operation",
        "args"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "drag"
        },
