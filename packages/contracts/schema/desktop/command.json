          "required": [
            "text"
          ]
        }
      },
      "required": [
        "operation",
        "args"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "key"
        },
        "args": {
          "type": "object",
          "properties": {
            "chords": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "minItems": 1,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "description": "The keys of one combination, pressed in order and released in reverse."
              },
              "description": "Combinations pressed in turn."
            },
            "repeat": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "chords",
            "repeat"
          ]
        }
      },
      "required": [
        "operation",
        "args"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "hold_key"
        },
        "args": {
          "type": "object",
          "properties": {
            "keys": {
              "minItems": 1,
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "description": "The keys of one combination, pressed in order and released in reverse."
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 300000
            }
          },
          "required": [
            "keys",
            "durationMs"
          ]
        }
      },
      "required": [
        "operation",
        "args"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "mouse_down"
        },
        "args": {
          "type": "object",
          "properties": {
            "button": {
              "type": "string",
              "const": "left"
            }
          },
          "required": [
            "button"
          ]
        }
      },
      "required": [
        "operation",
        "args"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "mouse_up"
        },
        "args": {
          "type": "object",
          "properties": {
            "button": {
              "type": "string",
              "const": "left"
            }
          },
          "required": [
            "button"
          ]
        }
      },
      "required": [
        "operation",
        "args"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "release"
        },
        "args": {
          "type": "object",
          "properties": {},
          "description": "Release every held button and key."
        }
      },
      "required": [
        "operation",
        "args"
      ]
