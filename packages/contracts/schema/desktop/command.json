                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "x",
                "y"
              ],
              "description": "A point on the display, in physical pixels from its top-left."
            },
            "to": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "x",
                "y"
              ],
              "description": "A point on the display, in physical pixels from its top-left."
            },
            "modifiers": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
