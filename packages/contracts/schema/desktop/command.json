          "required": [
            "from",
            "to",
            "modifiers"
          ]
        }
      },
      "required": [
        "operation",
        "args"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "move"
        },
        "args": {
          "type": "object",
          "properties": {
            "to": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "x",
                "y"
              ],
              "description": "A point on the display, in physical pixels from its top-left."
            }
          },
          "required": [
            "to"
          ]
        }
      },
      "required": [
        "operation",
        "args"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "scroll"
        },
        "args": {
          "type": "object",
          "properties": {
            "direction": {
              "type": "string",
              "enum": [
                "up",
                "down",
                "left",
                "right"
              ],
              "description": "Which way the wheel turns: up, down, left or right."
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "at": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "x",
                "y"
              ],
              "description": "A point on the display, in physical pixels from its top-left."
            },
            "modifiers": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "description": "Modifier keys held during the action."
            }
          },
          "required": [
            "direction",
            "amount",
            "modifiers"
          ]
        }
      },
      "required": [
        "operation",
        "args"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "type"
        },
        "args": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
