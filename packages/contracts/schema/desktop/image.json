{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DesktopImage",
  "type": "object",
  "properties": {
    "mimeType": {
      "type": "string",
      "enum": [
        "image/png",
        "image/jpeg"
      ],
      "description": "The image's type."
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "data": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]*={0,2}$",
      "description": "The image, base64."
    }
  },
  "required": [
    "mimeType",
    "width",
    "height",
    "data"
  ],
  "description": "An image of the display or a region, with its pixel size."
}
