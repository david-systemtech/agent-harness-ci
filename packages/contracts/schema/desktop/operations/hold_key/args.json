{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DesktopHoldKeyArgs",
  "type": "object",
  "properties": {
    "keys": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "description": "The keys of one combination, pressed in order and released in reverse."
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300000
    }
  },
  "required": [
    "keys",
    "durationMs"
  ]
}
