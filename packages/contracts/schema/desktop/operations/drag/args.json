{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DesktopDragArgs",
  "type": "object",
  "properties": {
    "from": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "x",
        "y"
      ],
      "description": "A point on the display, in physical pixels from its top-left."
    },
    "to": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "x",
        "y"
      ],
      "description": "A point on the display, in physical pixels from its top-left."
    },
    "modifiers": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "description": "Modifier keys held during the action."
    }
  },
  "required": [
    "from",
    "to",
    "modifiers"
  ]
}
