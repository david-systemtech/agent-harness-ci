{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComputerScrollInput",
  "type": "object",
  "properties": {
    "scroll_direction": {
      "type": "string",
      "enum": [
        "up",
        "down",
        "left",
        "right"
      ],
      "description": "Which way the wheel turns: up, down, left or right."
    },
    "scroll_amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "coordinate": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2,
      "description": "[x, y] in full-display screenshot pixels, even after a zoom."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Modifier keys held during the action, +-joined (shift, ctrl+alt)."
    }
  },
  "required": [
    "scroll_direction",
    "scroll_amount"
  ],
  "additionalProperties": false,
  "description": "scroll: turn the wheel scroll_amount steps, at coordinate or the cursor."
}
