{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitCredentialError",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "unauthorized"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {}
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "description": "The client session's token is missing, invalid, foreign or expired."
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "rate_limited"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "retryAfterMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Milliseconds until the next exchange is taken."
            }
          },
          "required": [
            "retryAfterMs"
          ]
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "description": "Too many exchanges from this address; data.retryAfterMs says when to try again."
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "invalid_params"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "path": {
                    "type": "array",
                    "items": {
                      "type": [
                        "string",
                        "number"
                      ]
                    }
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "path",
                  "message"
                ],
                "additionalProperties": {},
                "description": "One schema issue: a code, the path to the offending value and a message."
              }
            }
          },
          "required": [
            "issues"
          ]
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "description": "The params or the frame did not match the schema; data.issues lists the schema's issues."
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "credential_unavailable"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "pattern": "^(?:https:\\/\\/(?:[a-z0-9_-]+(?:\\.[a-z0-9_-]+)*|\\[[0-9a-f:.]+\\])(?::(?!443$)(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?|http:\\/\\/(?:[a-z0-9_-]+(?:\\.[a-z0-9_-]+)*|\\[[0-9a-f:.]+\\])(?::(?!80$)(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?)$",
              "description": "The origin git asked about."
            }
          },
          "required": [
            "origin"
          ]
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "description": "The forge account serving the origin has no credential to give now (gh or the key manager signed out, the vault entry missing, a copy awaiting one, its login not known yet); the message says which and what to do."
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "internal"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {}
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "description": "The environment failed; nothing the client sent is at fault."
    }
  ],
  "description": "Why the credential route gave git no credential."
}
