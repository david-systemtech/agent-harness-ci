{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForbiddenError",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "const": "forbidden"
    },
    "message": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "read",
            "sessions:write",
            "runs:drive",
            "terminal",
            "admin"
          ],
          "description": "One of the five scopes a method may require."
        }
      },
      "required": [
        "scope"
      ]
    }
  },
  "required": [
    "code",
    "message",
    "data"
  ],
  "description": "The client session lacks the scope the method requires, named in data.scope."
}
