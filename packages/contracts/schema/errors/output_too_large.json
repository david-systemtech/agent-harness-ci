{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OutputTooLargeError",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "const": "output_too_large"
    },
    "message": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "limitBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "The most output a pre-check may give, in bytes."
        }
      },
      "required": [
        "limitBytes"
      ]
    }
  },
  "required": [
    "code",
    "message",
    "data"
  ],
  "description": "A pre-check's output passed 1 MiB, so it was stopped and nothing of it kept. data says the limit."
}
