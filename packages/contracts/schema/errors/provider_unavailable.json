{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderUnavailableError",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "const": "provider_unavailable"
    },
    "message": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "openbao",
            "doppler",
            "onepassword",
            "bitwarden"
          ],
          "description": "The provider this environment cannot sign in to."
        }
      },
      "required": [
        "provider"
      ]
    }
  },
  "required": [
    "code",
    "message",
    "data"
  ],
  "description": "This environment cannot sign in to the provider: nothing was stored. data names the provider."
}
