{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProtocolMismatchError",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "const": "protocol_mismatch"
    },
    "message": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "The environment's own protocol version."
        }
      },
      "required": [
        "protocolVersion"
      ]
    }
  },
  "required": [
    "code",
    "message",
    "data"
  ],
  "description": "The client's protocol version is not the environment's, named in data; the code is not spent."
}
