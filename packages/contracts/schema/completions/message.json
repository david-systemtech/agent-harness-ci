{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChatMessage",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "system",
        "developer",
        "user",
        "assistant",
        "tool"
      ],
      "description": "Who wrote a message: system or developer (instructions, appended after the composed ones), user, assistant, or tool (a tool's result)."
    },
    "content": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The part's kind: text is read; images travel as agent-harness.attachments."
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": {},
                "description": "One part of a message's content."
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool_call_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool_calls": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {},
            "additionalProperties": {}
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "role"
  ],
  "additionalProperties": {},
  "description": "A message of the conversation: its role and its content, a string or text parts."
}
