{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KeyManagerTargetExistsError",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "const": "conflict"
    },
    "message": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "const": "target_exists"
        },
        "connectionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
          "description": "The connection the target is on."
        },
        "reference": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "const": "openbao"
                    },
                    "connectionId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                      "description": "The key-manager connection the reference is read through."
                    },
                    "mount": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024,
                      "pattern": "^[^/\\p{Cc}]+(?:\\/[^/\\p{Cc}]+)*$",
                      "description": "The KV mount, as personal or secret/team: no slash at either end."
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024,
                      "pattern": "^[^/\\p{Cc}]+(?:\\/[^/\\p{Cc}]+)*$",
                      "description": "The secret's path under the mount, as harness/forge-github."
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\p{Cc}]+$",
                      "description": "The key inside the secret whose value is read."
                    }
                  },
                  "required": [
                    "provider",
                    "connectionId",
                    "mount",
                    "path",
                    "key"
                  ],
                  "description": "A value in OpenBao or Vault: a key of the secret at a path under a KV mount."
                },
                {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "const": "doppler"
                    },
                    "connectionId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                      "description": "The key-manager connection the reference is read through."
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 256,
                      "pattern": "^[A-Z_][A-Z0-9_]*$",
                      "description": "The secret's name: upper-case letters, digits and underscores, not starting with a digit."
                    },
                    "project": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\p{Cc}]+$",
                      "description": "The project, when the connection's token does not fix one."
                    },
                    "config": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\p{Cc}]+$",
                      "description": "The config, when the connection's token does not fix one."
                    }
                  },
                  "required": [
                    "provider",
                    "connectionId",
                    "name"
                  ],
                  "description": "A Doppler secret by name, with its project and config when the token does not fix them."
                },
                {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "const": "onepassword"
                    },
                    "connectionId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                      "description": "The key-manager connection the reference is read through."
                    },
                    "vault": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\p{Cc}]+$",
                      "description": "The vault, by name or id."
                    },
                    "item": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\p{Cc}]+$",
                      "description": "The item, by name or id."
                    },
                    "field": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\p{Cc}]+$",
                      "description": "The field whose value is read."
                    }
                  },
                  "required": [
                    "provider",
                    "connectionId",
                    "vault",
                    "item",
                    "field"
                  ],
                  "description": "A 1Password field, as an op:// reference names it: vault, item and field."
                },
                {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "const": "bitwarden"
                    },
                    "connectionId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                      "description": "The key-manager connection the reference is read through."
                    },
                    "secretId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                      "description": "The secret's id, which is what is read."
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\p{Cc}]+$",
                      "description": "The secret's key, for display only."
                    }
                  },
                  "required": [
                    "provider",
                    "connectionId",
                    "secretId",
                    "key"
                  ],
                  "description": "A Bitwarden Secrets Manager secret by id, with its key for display."
                }
              ],
              "description": "Where a credential sits in a key manager, never its value: the provider, the connection it is read through, and the provider's locator (OpenBao mount, path and key; a Doppler name with its project and config; a 1Password vault, item and field; a Bitwarden secret id with its key)."
            },
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "const": "bitwarden"
                },
                "connectionId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                  "description": "The key-manager connection the reference is read through."
                },
                "project": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\p{Cc}]+$",
                  "description": "The base project name or id."
                },
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\p{Cc}]+$",
                  "description": "The secret key Move writes."
                }
              },
              "required": [
                "provider",
                "connectionId",
                "project",
                "key"
              ]
            }
          ],
          "description": "The target, as the reference the item would hold."
        }
      },
      "required": [
        "reason",
        "connectionId",
        "reference"
      ]
    }
  },
  "required": [
    "code",
    "message",
    "data"
  ],
  "description": "A different value is at the target already: nothing was written, and the item holds its stored value still. keyManagers.move with overwrite replaces it. The same value at the target is no conflict. Never either value."
}
