                            "config": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256,
                              "pattern": "^[^\\p{Cc}]+$",
                              "description": "The config, when the connection's token does not fix one."
                            }
                          },
                          "required": [
                            "provider",
                            "connectionId",
                            "name"
                          ],
                          "description": "A Doppler secret by name, with its project and config when the token does not fix them."
                        },
                        {
                          "type": "object",
                          "properties": {
                            "provider": {
                              "type": "string",
                              "const": "onepassword"
                            },
                            "connectionId": {
                              "type": "string",
                              "format": "uuid",
                              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                              "description": "The key-manager connection the reference is read through."
                            },
                            "vault": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256,
                              "pattern": "^[^\\p{Cc}]+$",
                              "description": "The vault, by name or id."
                            },
                            "item": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256,
                              "pattern": "^[^\\p{Cc}]+$",
                              "description": "The item, by name or id."
                            },
                            "field": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256,
                              "pattern": "^[^\\p{Cc}]+$",
                              "description": "The field whose value is read."
                            }
                          },
                          "required": [
                            "provider",
                            "connectionId",
                            "vault",
                            "item",
                            "field"
                          ],
                          "description": "A 1Password field, as an op:// reference names it: vault, item and field."
                        },
                        {
                          "type": "object",
                          "properties": {
                            "provider": {
                              "type": "string",
                              "const": "bitwarden"
                            },
                            "connectionId": {
                              "type": "string",
                              "format": "uuid",
                              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                              "description": "The key-manager connection the reference is read through."
                            },
                            "secretId": {
                              "type": "string",
                              "format": "uuid",
                              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                              "description": "The secret's id, which is what is read."
                            },
                            "key": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256,
