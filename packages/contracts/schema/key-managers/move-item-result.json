{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KeyManagerMoveItemResult",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "item": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "forge-account"
              ],
              "description": "What holds a stored value Move can take: forge-account (a forge account's pasted token)."
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\p{Cc}]+$",
              "description": "The item's id with its owner: a forge account's id."
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "description": "An item Move takes, by its kind and its owner's id for it."
        },
        "outcome": {
          "type": "string",
          "const": "moved"
        },
        "reference": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "const": "openbao"
                },
                "connectionId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                  "description": "The key-manager connection the reference is read through."
                },
                "mount": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^[^/\\p{Cc}]+(?:\\/[^/\\p{Cc}]+)*$",
                  "description": "The KV mount, as personal or secret/team: no slash at either end."
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^[^/\\p{Cc}]+(?:\\/[^/\\p{Cc}]+)*$",
                  "description": "The secret's path under the mount, as harness/forge-github."
                },
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\p{Cc}]+$",
                  "description": "The key inside the secret whose value is read."
                }
              },
              "required": [
                "provider",
                "connectionId",
                "mount",
                "path",
                "key"
              ],
              "description": "A value in OpenBao or Vault: a key of the secret at a path under a KV mount."
            },
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "const": "doppler"
                },
                "connectionId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                  "description": "The key-manager connection the reference is read through."
                },
                "name": {
                  "type": "string",
                  "maxLength": 256,
                  "pattern": "^[A-Z_][A-Z0-9_]*$",
                  "description": "The secret's name: upper-case letters, digits and underscores, not starting with a digit."
                },
                "project": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\p{Cc}]+$",
                  "description": "The project, when the connection's token does not fix one."
                },
                "config": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\p{Cc}]+$",
                  "description": "The config, when the connection's token does not fix one."
                }
              },
              "required": [
                "provider",
                "connectionId",
                "name"
              ],
              "description": "A Doppler secret by name, with its project and config when the token does not fix them."
            },
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "const": "onepassword"
                },
                "connectionId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                  "description": "The key-manager connection the reference is read through."
                },
                "vault": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\p{Cc}]+$",
                  "description": "The vault, by name or id."
                },
                "item": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\p{Cc}]+$",
                  "description": "The item, by name or id."
                },
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\p{Cc}]+$",
                  "description": "The field whose value is read."
                }
              },
              "required": [
                "provider",
                "connectionId",
                "vault",
                "item",
                "field"
              ],
              "description": "A 1Password field, as an op:// reference names it: vault, item and field."
            },
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "const": "bitwarden"
                },
                "connectionId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                  "description": "The key-manager connection the reference is read through."
