                "secretId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "description": "The secret's id, which is what is read."
                },
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\p{Cc}]+$",
                  "description": "The secret's key, for display only."
                }
              },
              "required": [
                "provider",
                "connectionId",
                "secretId",
                "key"
              ],
              "description": "A Bitwarden Secrets Manager secret by id, with its key for display."
            }
          ],
          "description": "The reference the item holds now."
        },
        "storedValueDeleted": {
          "type": "boolean",
          "description": "Whether the stored value was deleted; one whose delete failed is deleted at the next start."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "description": "One line for people: where it went, and whether the stored value was deleted."
        }
      },
      "required": [
        "item",
        "outcome",
        "reference",
        "storedValueDeleted",
        "message"
      ],
      "description": "The item was written, read back, swapped to its reference and its stored value deleted, or left for the next start to delete."
    },
