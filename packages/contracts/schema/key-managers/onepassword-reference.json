{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OnePasswordReference",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "const": "onepassword"
    },
    "connectionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "description": "The key-manager connection the reference is read through."
    },
    "vault": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\p{Cc}]+$",
      "description": "The vault, by name or id."
    },
    "item": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\p{Cc}]+$",
      "description": "The item, by name or id."
    },
    "field": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\p{Cc}]+$",
      "description": "The field whose value is read."
    }
  },
  "required": [
    "provider",
    "connectionId",
    "vault",
    "item",
    "field"
  ],
  "description": "A 1Password field, as an op:// reference names it: vault, item and field."
}
