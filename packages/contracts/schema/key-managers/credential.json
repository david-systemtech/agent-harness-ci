{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KeyManagerCredential",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "approle"
        },
        "roleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[\\x21-\\x7e]+$",
          "description": "The AppRole's role id."
        },
        "secretId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[\\x21-\\x7e]+$",
          "description": "The AppRole's secret id."
        }
      },
      "required": [
        "method",
        "roleId",
        "secretId"
      ],
      "description": "An AppRole's role id and secret id."
    },
    {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "userpass"
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\p{Cc}]+$",
          "description": "The userpass password: printable, on one line."
        }
      },
      "required": [
        "method",
        "password"
      ],
      "description": "A userpass password; the username is the connection's."
    },
    {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "token"
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[\\x21-\\x7e]+$",
          "description": "The token."
        }
      },
      "required": [
        "method",
        "token"
      ],
      "description": "A token, looked up to sign in."
    }
  ],
  "description": "A key-manager connection's credential, sent once and never answered back: an AppRole's role id and secret id, a userpass password, or a token. The environment keeps it in its vault to sign in again by itself."
}
