{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BitwardenReference",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "const": "bitwarden"
    },
    "connectionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "description": "The key-manager connection the reference is read through."
    },
    "secretId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "The secret's id, which is what is read."
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\p{Cc}]+$",
      "description": "The secret's key, for display only."
    }
  },
  "required": [
    "provider",
    "connectionId",
    "secretId",
    "key"
  ],
  "description": "A Bitwarden Secrets Manager secret by id, with its key for display."
}
