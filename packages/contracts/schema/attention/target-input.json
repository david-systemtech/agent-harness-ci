{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AttentionTargetInput",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "transport": {
      "type": "string",
      "enum": [
        "webhook",
        "push"
      ],
      "description": "Closed-client delivery transport: signed webhook or Web Push."
    },
    "enabled": {
      "type": "boolean"
    },
    "completion": {
      "type": "boolean"
    },
    "configuration": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 100
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 4096
      }
    }
  },
  "required": [
    "id",
    "transport",
    "enabled",
    "completion",
    "configuration"
  ],
  "additionalProperties": false
}
