{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AttentionPayload",
  "type": "object",
  "properties": {
    "message": {
      "type": "string",
      "const": "A session needs you"
    },
    "url": {
      "type": "string",
      "pattern": "^https:\\/\\/(?:[a-z0-9.-]+|\\[[0-9a-f:]+\\])(?::(?!443\\/)[1-9][0-9]{0,4})?\\/#\\/session\\/[^/?#]+\\/[^/?#]+$"
    }
  },
  "required": [
    "message",
    "url"
  ],
  "additionalProperties": false
}
