{
  "name": "agent-harness-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @agent-harness/contracts build-validator && pnpm --filter @agent-harness/extension build && pnpm --filter @agent-harness/gui build && node scripts/stage-web-client.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.66.1",
    "@types/node": "^24.0.0",
    "@typescript-eslint/rule-tester": "^8.70.1",
    "@typescript-eslint/utils": "^8.70.1",
    "eslint": "^10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "@typescript/native": "npm:typescript@~7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.0"
  }
}
