{
  // Everything that is not a package's shipped source: tests, configs and the
  // lint rules. Type-checked only; the packages it imports resolve to their
  // referenced projects' declarations.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild/tooling",
    "emitDeclarationOnly": true,
    "types": ["node"],
    // The terminal UI's tests import its Ink components.
    "jsx": "react-jsx"
  },
  "include": [
    "*.ts",
    "eslint-rules",
    "test",
    "packages/*/vitest.config.ts",
    "packages/*/vite.config.ts",
    "packages/*/scripts",
    "packages/*/test",
    "packages/*/src/**/*.test.ts"
  ],
  // The GUI's and the browser package's tests run in jsdom and are checked with the DOM's types in each package's
  // tsconfig.test.json.
  "exclude": ["packages/gui/src", "packages/gui/test", "packages/browser/src", "packages/browser/test"],
  "references": [
    { "path": "packages/contracts" },
    { "path": "packages/environment" },
    { "path": "packages/client-runtime" },
    { "path": "packages/theme" },
    { "path": "packages/tui" },
    { "path": "packages/desktop" },
    { "path": "packages/cli" }
  ]
}
