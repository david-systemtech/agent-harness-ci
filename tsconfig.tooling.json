{
  // Everything that is not a package's shipped source: tests, configs and the
  // lint rules. Type-checked only; the packages it imports resolve to their
  // referenced projects' declarations.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild/tooling",
    "emitDeclarationOnly": true,
    "types": ["node"],
    // The terminal UI's tests import its Ink components.
    "jsx": "react-jsx"
  },
  // Hosted phone regressions are Node helpers consumed by the existing smoke executable.
  "files": ["packages/gui/test/web-client/phone-surfaces.ts", "packages/gui/test/web-client/phone-fallback.ts"],
  "include": [
    "*.ts",
    "eslint-rules",
    "test",
    "packages/*/vitest.config.ts",
    "packages/*/vite.config.ts",
    "packages/*/scripts",
    "packages/*/test",
    "packages/*/src/**/*.test.ts"
  ],
  // The GUI's tests run in jsdom, the browser package's parse pages with it and the extension's drive its options page in
  // it, so each package's tsconfig.test.json checks them with the DOM's types.
  "exclude": ["packages/gui/src", "packages/gui/test", "packages/browser/src", "packages/browser/test", "packages/extension/src", "packages/extension/test", "packages/extension/scripts/**/*.test.ts", "packages/desktop/src/preload/camera.test.ts", "packages/desktop/test/jsdom.d.ts"],
  "references": [
    { "path": "packages/contracts" },
    { "path": "packages/filesystem" },
    { "path": "packages/environment" },
    { "path": "packages/client-runtime" },
    { "path": "packages/theme" },
    // The environment's headless browser tests drive the scripted CDP peer, the browser package's testing export.
    { "path": "packages/browser/tsconfig.testing.json" },
    { "path": "packages/tui" },
    { "path": "packages/desktop" },
    { "path": "packages/extension" },
    { "path": "packages/cli" }
  ]
}
